---
/*
 * Latin subsets only. The unscoped entrypoints also ship Cyrillic, Greek and
 * Vietnamese, which this site will never render — browsers would not download
 * them (unicode-range prevents that), but they bloat every deploy artifact.
 */
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-ext-400.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-sans/latin-ext-600.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-ext-500.css';
import '../styles/tokens.css';
import '../styles/global.css';

import { SITE_NAME } from '../site';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title === SITE_NAME ? title : `${title} — ${SITE_NAME}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      GitHub Pages serves a fixed set of response headers and offers no way to
      add our own, so the policy has to travel in the document. Two caveats
      that are properties of `<meta>` CSP, not oversights:
        - `frame-ancestors` is ignored here; clickjacking protection needs a
          real header. Deferred to Phase 9 (`staticwebapp.config.json`) if we
          ever move to Azure.
        - `X-Content-Type-Options` cannot be expressed as a meta tag at all.
      HTTPS is already enforced by Pages itself.

      `script-src 'self'` rather than 'none': the site ships zero JS today, but
      the commute islands in Phase 6 will. Re-verify this policy when the first
      island lands (P6.3) — a CSP violation fails silently for visitors.
    */}
    {/*
      Production only. `astro dev` serves every stylesheet as an inline
      <style> tag, which `style-src 'self'` forbids — with the meta tag
      present in dev the whole site renders unstyled. The policy protects the
      deployed site, and localhost is not the deployed site.

      The cost: dev no longer exercises the CSP, so a violation cannot show up
      until the built output is served. Test it with `npm run build && npm run
      preview`, not with `npm run dev` — especially when the commute islands
      land in P6.3, since a CSP violation fails silently for visitors.
    */}
    {
      import.meta.env.PROD && (
        <meta
          http-equiv="Content-Security-Policy"
          content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'"
        />
      )
    }
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="shell">
      <header class="masthead">
        <a class="masthead__name" href="/">{SITE_NAME}</a>
        <nav aria-label="Primary">
          <ul class="masthead__nav">
            <li><a href="/data-science/">ML &amp; Data Science</a></li>
            <li><a href="/business/">Business &amp; LLMs</a></li>
          </ul>
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="colophon">
        {/*
          Points at the profile, not this repo — so the wording can no longer
          say "Source on", which promises the repository specifically.
        */}
        <p>
          Built with Astro. Find me on <a href="https://github.com/pat-rig"
            >GitHub</a
          >.
        </p>
      </footer>
    </div>
  </body>
</html>

<style>
  .shell {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    max-width: var(--width-wide);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  main {
    flex: 1;
  }

  /*
   * Masthead: a rule under it, no shadow, no card. The name is the only
   * thing set in mono — it reads as a label on a board rather than a logo.
   */
  .masthead {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    align-items: baseline;
    justify-content: space-between;
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--space-7);
  }

  .masthead__name {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--step-0);
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .masthead__name:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .masthead__nav {
    display: flex;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    font-size: var(--step--1);
    color: var(--text-1);
  }

  .colophon {
    margin-top: var(--space-9);
    padding-block: var(--space-5);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--text-1);
  }
</style>

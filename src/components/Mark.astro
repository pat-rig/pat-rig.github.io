---
/*
 * Small data-marks used as the visual anchor beside each entry. They are
 * drawn in `currentColor` so they invert with the theme, and carry no colour
 * of their own — colour stays reserved for the commute visualisation, per
 * the design system.
 *
 * Decorative only: the adjacent title carries the meaning, so each is
 * aria-hidden and adds nothing to the accessibility tree.
 */
export type MarkName =
  | 'grid'
  | 'distribution'
  | 'network'
  | 'bars'
  | 'fork'
  | 'lines'
  | 'contour';

interface Props {
  name: MarkName;
}

const { name } = Astro.props;

// Deterministic opacities for the grid mark: a fixed pattern, not random, so
// the mark renders identically on every build.
const gridCells = [
  0.25, 0.45, 0.2, 0.35, 0.5, 1, 0.75, 0.3, 0.3, 0.6, 0.9, 0.45, 0.15, 0.3, 0.5, 0.2,
];
---

<span class="mark" aria-hidden="true">
  {
    name === 'grid' && (
      <svg viewBox="0 0 40 40" fill="none">
        <g fill="currentColor">
          {gridCells.map((opacity, i) => (
            <rect
              x={1 + (i % 4) * 10}
              y={1 + Math.floor(i / 4) * 10}
              width="8"
              height="8"
              opacity={opacity}
            />
          ))}
        </g>
      </svg>
    )
  }

  {
    name === 'distribution' && (
      <svg viewBox="0 0 40 40" fill="none">
        <path
          d="M2 34 Q10 34 13 22 Q16 6 20 6 Q24 6 27 22 Q30 34 38 34"
          stroke="currentColor"
          stroke-width="2"
        />
        <line
          x1="20"
          y1="6"
          x2="20"
          y2="34"
          stroke="currentColor"
          stroke-width="1"
          opacity=".5"
          stroke-dasharray="2 2"
        />
        <line x1="2" y1="34" x2="38" y2="34" stroke="currentColor" stroke-width="1" opacity=".6" />
      </svg>
    )
  }

  {
    name === 'network' && (
      <svg viewBox="0 0 40 40" fill="none">
        <g stroke="currentColor" stroke-width="1.5" opacity=".7">
          <line x1="8" y1="10" x2="20" y2="20" />
          <line x1="32" y1="8" x2="20" y2="20" />
          <line x1="20" y1="20" x2="10" y2="32" />
          <line x1="20" y1="20" x2="31" y2="30" />
        </g>
        <g fill="currentColor">
          <circle cx="8" cy="10" r="3" />
          <circle cx="32" cy="8" r="2.5" />
          <circle cx="20" cy="20" r="4" />
          <circle cx="10" cy="32" r="2.5" />
          <circle cx="31" cy="30" r="3" />
        </g>
      </svg>
    )
  }

  {
    name === 'bars' && (
      <svg viewBox="0 0 40 40" fill="none">
        <g stroke="currentColor" stroke-width="2">
          <rect x="3" y="6" width="34" height="7" opacity=".8" />
          <rect x="3" y="17" width="24" height="7" opacity=".55" />
          <rect x="3" y="28" width="14" height="7" opacity=".3" />
        </g>
      </svg>
    )
  }

  {
    name === 'fork' && (
      <svg viewBox="0 0 40 40" fill="none">
        <g stroke="currentColor" stroke-width="2" opacity=".7">
          <path d="M4 20 h9" />
          <path d="M27 12 h9" />
          <path d="M27 28 h9" />
          <path d="M13 20 C20 20 20 12 27 12" />
          <path d="M13 20 C20 20 20 28 27 28" />
        </g>
        <g fill="currentColor">
          <circle cx="13" cy="20" r="3" />
          <circle cx="27" cy="12" r="3" />
          <circle cx="27" cy="28" r="3" />
        </g>
      </svg>
    )
  }

  {/*
    Contour lines of a two-component Gaussian mixture — a density with two
    separated modes, drawn the way a topographic map draws hills.

    The paths are real marching-squares contours, generated once from the
    mixture and pasted in as static data rather than computed at runtime.
    Four levels only: the mark is drawn at ~37px, so rings closer than about
    3 viewBox units smear into a grey blob — a fifth level came out 3 units
    across and read as a dot. The outermost ring encloses both modes and the
    inner ones pull apart, which is the whole point of it.
  */}
  {
    name === 'contour' && (
      <svg viewBox="0 0 40 40" fill="none">
        <g stroke="currentColor" stroke-width="1" stroke-linejoin="round" opacity=".85">
          <path d="M26.7 7.9L24.6 8.3L22.7 9.2L21.1 10.3L19.9 11.6L18.9 13.3L18.1 15.3L17.0 16.8L14.7 17.0L12.2 17.0L9.8 17.2L7.9 17.8L6.2 18.8L4.8 20.2L3.9 21.8L3.4 24.1L3.8 26.5L4.6 28.3L5.7 29.8L7.0 31.2L8.6 32.3L10.4 33.1L12.5 33.7L14.8 34.0L17.2 33.8L19.2 33.1L20.9 32.1L22.2 30.8L23.2 29.1L23.6 27.0L23.8 24.4L24.9 22.8L26.9 22.3L29.1 21.8L31.0 21.0L32.6 19.9L33.9 18.6L34.9 17.0L35.5 14.9L35.2 12.5L34.4 10.8L33.0 9.4L31.3 8.5L29.1 7.9Z" />
          <path d="M11.8 19.3L10.7 19.4L9.8 19.7L8.9 20.1L8.2 20.6L7.5 21.2L7.0 21.8L6.5 22.7L6.2 23.5L6.1 24.7L6.3 25.8L6.6 26.8L7.0 27.6L7.5 28.4L8.1 29.0L8.7 29.6L9.4 30.2L10.2 30.6L11.1 31.0L11.9 31.3L13.0 31.6L14.0 31.7L15.2 31.7L16.3 31.6L17.2 31.3L18.1 30.9L18.8 30.4L19.5 29.8L20.1 29.1L20.5 28.3L20.8 27.5L20.9 26.2L20.8 25.0L20.5 24.0L20.2 23.1L19.7 22.4L19.2 21.7L18.5 21.1L17.7 20.6L16.9 20.2L16.1 19.9L15.1 19.6L14.0 19.4L13.0 19.3Z" />
          <path d="M26.0 10.2L25.3 10.4L24.6 10.6L23.9 11.0L23.3 11.4L22.8 11.8L22.2 12.4L21.8 12.9L21.5 13.6L21.2 14.3L21.0 15.2L20.9 15.9L21.0 16.7L21.3 17.5L21.6 18.1L22.1 18.7L22.6 19.2L23.2 19.5L24.0 19.8L24.8 20.0L25.8 20.1L26.8 20.0L27.8 19.9L28.6 19.7L29.2 19.5L30.0 19.1L30.6 18.7L31.1 18.3L31.6 17.8L32.1 17.2L32.5 16.6L32.7 15.9L32.9 15.1L33.0 14.1L32.8 13.3L32.5 12.6L32.1 12.0L31.6 11.5L31.1 11.0L30.4 10.6L29.8 10.4L29.0 10.1L28.0 10.0L27.0 10.0Z" />
          <path d="M11.5 21.3L10.9 21.5L10.4 21.7L9.8 22.1L9.4 22.5L9.0 23.0L8.7 23.4L8.5 24.1L8.4 24.9L8.5 25.7L8.7 26.3L9.0 26.9L9.3 27.4L9.7 27.9L10.1 28.3L10.6 28.6L11.1 29.0L11.6 29.2L12.3 29.5L12.9 29.7L13.7 29.8L14.6 29.8L15.4 29.7L16.1 29.5L16.7 29.2L17.2 28.9L17.6 28.5L18.0 28.0L18.3 27.5L18.5 26.9L18.6 26.1L18.5 25.2L18.3 24.6L18.1 24.0L17.7 23.5L17.3 23.1L16.9 22.6L16.4 22.3L15.9 22.0L15.3 21.7L14.7 21.5L14.1 21.3L13.2 21.2L12.4 21.2Z" />
          <path d="M26.5 12.0L26.0 12.2L25.6 12.3L25.2 12.5L24.8 12.8L24.4 13.1L24.2 13.3L23.9 13.7L23.7 14.1L23.5 14.5L23.4 14.9L23.4 15.5L23.4 16.0L23.6 16.4L23.8 16.8L24.1 17.2L24.5 17.4L24.8 17.6L25.3 17.8L25.8 18.0L26.2 18.0L26.8 18.1L27.2 18.0L27.8 17.9L28.2 17.8L28.6 17.6L29.0 17.3L29.4 17.1L29.7 16.8L30.0 16.4L30.2 16.1L30.4 15.7L30.6 15.2L30.6 14.5L30.5 13.9L30.3 13.5L30.1 13.2L29.8 12.9L29.5 12.6L29.1 12.4L28.7 12.2L28.2 12.0L27.7 12.0L27.0 12.0Z" />
          <path d="M12.2 23.2L11.9 23.3L11.6 23.5L11.3 23.7L11.1 23.9L10.9 24.2L10.7 24.5L10.6 25.0L10.6 25.5L10.8 25.9L10.9 26.2L11.1 26.5L11.3 26.8L11.5 27.0L11.8 27.2L12.1 27.4L12.4 27.6L12.8 27.7L13.1 27.8L13.6 27.9L14.0 27.9L14.5 27.9L15.0 27.8L15.3 27.6L15.6 27.4L15.8 27.2L16.0 27.0L16.2 26.7L16.4 26.2L16.4 26.0L16.4 25.6L16.3 25.2L16.2 24.9L16.0 24.5L15.8 24.3L15.6 24.0L15.3 23.8L15.0 23.6L14.7 23.4L14.4 23.3L14.1 23.2L13.6 23.1L13.1 23.1L12.6 23.1Z" />
        </g>
      </svg>
    )
  }

  {
    name === 'lines' && (
      <svg viewBox="0 0 40 40" fill="none">
        <g stroke="currentColor" stroke-width="2" opacity=".65">
          <line x1="5" y1="9" x2="35" y2="9" />
          <line x1="5" y1="16" x2="35" y2="16" />
          <line x1="5" y1="23" x2="28" y2="23" />
          <line x1="5" y1="30" x2="20" y2="30" />
        </g>
      </svg>
    )
  }
</span>

<style>
  /*
   * Sized by the grid column it sits in rather than fixed, so the entry layout
   * can shrink it on narrow screens without the mark ever having to leave the
   * text's side. Square by aspect-ratio, not by matching width and height.
   */
  .mark {
    width: 100%;
    aspect-ratio: 1;
    color: var(--text-2);
    background: var(--surface-1);
    border: 1px solid var(--line);
    padding: 0.4rem;
  }

  .mark :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

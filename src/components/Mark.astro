---
/*
 * Small data-marks used as the visual anchor beside each entry. They are
 * drawn in `currentColor` so they invert with the theme, and carry no colour
 * of their own — colour stays reserved for the commute visualisation, per
 * the design system.
 *
 * Decorative only: the adjacent title carries the meaning, so each is
 * aria-hidden and adds nothing to the accessibility tree.
 */
export type MarkName =
  | 'grid'
  | 'distribution'
  | 'network'
  | 'bars'
  | 'fork'
  | 'lines'
  | 'contour'
  | 'virus'
  | 'vessels'
  | 'microbe'
  | 'sigma';

interface Props {
  name: MarkName;
}

const { name } = Astro.props;

// Deterministic opacities for the grid mark: a fixed pattern, not random, so
// the mark renders identically on every build.
const gridCells = [
  0.25, 0.45, 0.2, 0.35, 0.5, 1, 0.75, 0.3, 0.3, 0.6, 0.9, 0.45, 0.15, 0.3, 0.5, 0.2,
];
---

<span class="mark" aria-hidden="true">
  {
    name === 'grid' && (
      <svg viewBox="0 0 40 40" fill="none">
        <g fill="currentColor">
          {gridCells.map((opacity, i) => (
            <rect
              x={1 + (i % 4) * 10}
              y={1 + Math.floor(i / 4) * 10}
              width="8"
              height="8"
              opacity={opacity}
            />
          ))}
        </g>
      </svg>
    )
  }

  {
    name === 'distribution' && (
      <svg viewBox="0 0 40 40" fill="none">
        <path
          d="M2 34 Q10 34 13 22 Q16 6 20 6 Q24 6 27 22 Q30 34 38 34"
          stroke="currentColor"
          stroke-width="2"
        />
        <line
          x1="20"
          y1="6"
          x2="20"
          y2="34"
          stroke="currentColor"
          stroke-width="1"
          opacity=".5"
          stroke-dasharray="2 2"
        />
        <line x1="2" y1="34" x2="38" y2="34" stroke="currentColor" stroke-width="1" opacity=".6" />
      </svg>
    )
  }

  {
    name === 'network' && (
      <svg viewBox="0 0 40 40" fill="none">
        <g stroke="currentColor" stroke-width="1.5" opacity=".7">
          <line x1="8" y1="10" x2="20" y2="20" />
          <line x1="32" y1="8" x2="20" y2="20" />
          <line x1="20" y1="20" x2="10" y2="32" />
          <line x1="20" y1="20" x2="31" y2="30" />
        </g>
        <g fill="currentColor">
          <circle cx="8" cy="10" r="3" />
          <circle cx="32" cy="8" r="2.5" />
          <circle cx="20" cy="20" r="4" />
          <circle cx="10" cy="32" r="2.5" />
          <circle cx="31" cy="30" r="3" />
        </g>
      </svg>
    )
  }

  {
    name === 'bars' && (
      <svg viewBox="0 0 40 40" fill="none">
        <g stroke="currentColor" stroke-width="2">
          <rect x="3" y="6" width="34" height="7" opacity=".8" />
          <rect x="3" y="17" width="24" height="7" opacity=".55" />
          <rect x="3" y="28" width="14" height="7" opacity=".3" />
        </g>
      </svg>
    )
  }

  {
    name === 'fork' && (
      <svg viewBox="0 0 40 40" fill="none">
        <g stroke="currentColor" stroke-width="2" opacity=".7">
          <path d="M4 20 h9" />
          <path d="M27 12 h9" />
          <path d="M27 28 h9" />
          <path d="M13 20 C20 20 20 12 27 12" />
          <path d="M13 20 C20 20 20 28 27 28" />
        </g>
        <g fill="currentColor">
          <circle cx="13" cy="20" r="3" />
          <circle cx="27" cy="12" r="3" />
          <circle cx="27" cy="28" r="3" />
        </g>
      </svg>
    )
  }

  {/*
    Contour lines of a two-component Gaussian mixture — a density with two
    separated modes, drawn the way a topographic map draws hills.

    The paths are real marching-squares contours, generated once from the
    mixture and pasted in as static data rather than computed at runtime.
    Four levels only: the mark is drawn at ~37px, so rings closer than about
    3 viewBox units smear into a grey blob — a fifth level came out 3 units
    across and read as a dot. The outermost ring encloses both modes and the
    inner ones pull apart, which is the whole point of it.
  */}
  {
    name === 'contour' && (
      <svg viewBox="0 0 40 40" fill="none">
        <g stroke="currentColor" stroke-width="1" stroke-linejoin="round" opacity=".85">
          <path d="M28.1 5.4L25.8 5.9L23.7 6.8L21.9 8.0L20.5 9.5L19.3 11.4L18.5 13.6L17.2 15.3L14.6 15.6L11.9 15.5L9.2 15.8L7.0 16.5L5.1 17.6L3.6 19.1L2.5 21.0L2.0 23.5L2.4 26.2L3.3 28.3L4.5 30.0L6.1 31.5L7.8 32.7L9.8 33.7L12.1 34.4L14.7 34.6L17.5 34.4L19.7 33.7L21.6 32.5L23.0 31.1L24.1 29.1L24.7 26.8L24.8 23.8L26.1 22.1L28.4 21.5L30.9 20.9L32.9 20.0L34.7 18.9L36.2 17.4L37.4 15.5L38.0 13.2L37.7 10.5L36.7 8.6L35.1 7.1L33.3 6.0L30.8 5.4Z" />
          <path d="M11.4 18.1L10.2 18.3L9.2 18.6L8.2 19.0L7.4 19.6L6.6 20.2L6.0 21.0L5.5 21.9L5.2 22.9L5.0 24.3L5.2 25.5L5.5 26.6L6.0 27.5L6.6 28.3L7.2 29.1L7.9 29.7L8.7 30.3L9.6 30.9L10.6 31.3L11.5 31.7L12.7 31.9L13.9 32.1L15.2 32.1L16.4 31.9L17.5 31.6L18.5 31.1L19.3 30.6L20.0 30.0L20.7 29.2L21.2 28.3L21.5 27.3L21.6 25.9L21.5 24.5L21.2 23.4L20.8 22.4L20.3 21.6L19.7 20.8L18.9 20.2L18.1 19.6L17.1 19.1L16.2 18.8L15.0 18.4L13.9 18.2L12.7 18.1Z" />
          <path d="M27.4 7.9L26.5 8.1L25.8 8.4L25.0 8.8L24.3 9.3L23.7 9.8L23.1 10.4L22.6 11.0L22.2 11.7L21.9 12.6L21.7 13.5L21.6 14.3L21.7 15.3L22.0 16.2L22.4 16.8L22.9 17.5L23.5 18.0L24.2 18.4L25.1 18.7L26.0 18.9L27.1 19.0L28.3 19.0L29.3 18.8L30.2 18.6L31.0 18.3L31.8 17.9L32.5 17.5L33.1 17.0L33.7 16.4L34.2 15.8L34.6 15.1L34.9 14.4L35.1 13.4L35.1 12.3L35.0 11.5L34.6 10.7L34.2 10.0L33.7 9.4L33.0 8.9L32.3 8.4L31.6 8.1L30.7 7.9L29.6 7.7L28.5 7.7Z" />
          <path d="M11.1 20.4L10.4 20.6L9.8 20.9L9.2 21.3L8.7 21.7L8.2 22.2L7.9 22.8L7.7 23.5L7.6 24.4L7.7 25.3L7.9 26.1L8.2 26.7L8.6 27.2L9.0 27.8L9.5 28.2L10.0 28.6L10.6 29.0L11.2 29.3L11.9 29.6L12.6 29.8L13.6 29.9L14.5 29.9L15.5 29.8L16.2 29.6L16.9 29.3L17.4 28.9L17.9 28.5L18.4 28.0L18.7 27.4L18.9 26.7L19.1 25.8L18.9 24.8L18.7 24.1L18.4 23.4L18.1 22.9L17.6 22.4L17.1 21.9L16.6 21.5L16.0 21.1L15.4 20.8L14.7 20.6L14.0 20.4L13.0 20.3L12.1 20.3Z" />
          <path d="M27.9 10.0L27.4 10.1L26.9 10.3L26.5 10.5L26.0 10.8L25.6 11.1L25.3 11.4L25.0 11.9L24.7 12.3L24.5 12.8L24.4 13.2L24.4 13.9L24.4 14.4L24.6 14.9L24.9 15.3L25.2 15.7L25.6 16.0L26.0 16.3L26.5 16.5L27.1 16.7L27.6 16.7L28.2 16.7L28.7 16.7L29.4 16.6L29.8 16.4L30.3 16.2L30.7 15.9L31.2 15.6L31.5 15.3L31.8 14.9L32.1 14.5L32.3 14.1L32.5 13.5L32.5 12.8L32.4 12.1L32.2 11.7L31.9 11.2L31.6 10.9L31.2 10.6L30.8 10.4L30.3 10.2L29.8 10.0L29.2 9.9L28.5 9.9Z" />
          <path d="M11.8 22.5L11.5 22.6L11.2 22.8L10.9 23.0L10.6 23.3L10.3 23.7L10.2 24.0L10.1 24.5L10.1 25.1L10.2 25.6L10.4 25.9L10.6 26.2L10.8 26.5L11.1 26.8L11.4 27.1L11.7 27.3L12.0 27.4L12.5 27.6L12.8 27.7L13.4 27.8L13.9 27.8L14.5 27.8L14.9 27.6L15.3 27.5L15.6 27.3L15.9 27.0L16.1 26.7L16.3 26.5L16.5 25.9L16.5 25.6L16.5 25.2L16.5 24.8L16.3 24.4L16.1 24.0L15.8 23.7L15.6 23.5L15.3 23.2L15.0 23.0L14.6 22.8L14.3 22.6L14.0 22.5L13.4 22.4L12.9 22.4L12.3 22.4Z" />
        </g>
      </svg>
    )
  }

  {/*
    One of two pictograms in the set (the other is `microbe`) — everything
    else here abstracts a shape of data rather than depicting a subject. It
    earns the exception by being a glyph a reader recognises instantly, and it
    is held to the same rules as the rest: currentColor only, no fills but the
    dots, geometry on the same 40-unit grid. Eight spikes evenly spaced,
    because at ~37px an irregular scatter reads as a smudge rather than as a
    virus.
  */}
  {
    name === 'virus' && (
      <svg viewBox="0 0 40 40" fill="none">
        <circle cx="20" cy="20" r="9.2" stroke="currentColor" stroke-width="1.6" />
        <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <line x1="20" y1="10.8" x2="20" y2="5.8" />
          <line x1="26.5" y1="13.5" x2="30.0" y2="10.0" />
          <line x1="29.2" y1="20" x2="34.2" y2="20" />
          <line x1="26.5" y1="26.5" x2="30.0" y2="30.0" />
          <line x1="20" y1="29.2" x2="20" y2="34.2" />
          <line x1="13.5" y1="26.5" x2="10.0" y2="30.0" />
          <line x1="10.8" y1="20" x2="5.8" y2="20" />
          <line x1="13.5" y1="13.5" x2="10.0" y2="10.0" />
        </g>
        <g fill="currentColor">
          <circle cx="20" cy="5.4" r="1.7" />
          <circle cx="30.3" cy="9.7" r="1.7" />
          <circle cx="34.6" cy="20" r="1.7" />
          <circle cx="30.3" cy="30.3" r="1.7" />
          <circle cx="20" cy="34.6" r="1.7" />
          <circle cx="9.7" cy="30.3" r="1.7" />
          <circle cx="5.4" cy="20" r="1.7" />
          <circle cx="9.7" cy="9.7" r="1.7" />
        </g>
        <g fill="currentColor" opacity=".55">
          <circle cx="16.9" cy="17.6" r="1.9" />
          <circle cx="23.1" cy="21.1" r="1.6" />
          <circle cx="18.6" cy="24.1" r="1.3" />
        </g>
      </svg>
    )
  }

  {
    name === 'lines' && (
      <svg viewBox="0 0 40 40" fill="none">
        <g stroke="currentColor" stroke-width="2" opacity=".65">
          <line x1="5" y1="9" x2="35" y2="9" />
          <line x1="5" y1="16" x2="35" y2="16" />
          <line x1="5" y1="23" x2="28" y2="23" />
          <line x1="5" y1="30" x2="20" y2="30" />
        </g>
      </svg>
    )
  }

  {/*
    A segmented retinal vessel tree: the fundus rim, the optic disc it all
    emerges from, and the arcades sweeping around the macula. Drawn the way a
    segmentation mask reads rather than the way a photograph does — vessels
    only, no tissue — with the stroke thinning at each bifurcation, which is
    the one property of the vasculature that carries clinical meaning and the
    thing these models are measured on getting right.
  */}
  {
    name === 'vessels' && (
      <svg viewBox="0 0 40 40" fill="none">
        {/*
          Scaled about the centre so the fundus nearly fills the tile. The
          geometry below is authored against a 17.4-unit rim because that is
          the radius the curves were fitted to; enlarging here rather than
          rewriting every control point keeps the drawing editable, and the
          transform takes the stroke widths up with it so the weights stay
          in proportion. 1.1 is the hard ceiling — at that scale the rim's
          stroke lands 0.25 units short of the viewBox edge and reads as
          flush. 1.06 keeps a thin ring of ground outside the fundus, so the
          circle sits in the tile rather than straining against it.
        */}
        <g transform="translate(20 20) scale(1.06) translate(-20 -20)">
        <circle cx="20" cy="20" r="17.4" stroke="currentColor" stroke-width="1.1" opacity=".38" />
        <g stroke="currentColor" stroke-linecap="round">
          {/* The two major arcades, thickest at the disc. */}
          <path d="M24.6 18.2 Q16 10.5 8 11.4" stroke-width="2.1" />
          <path d="M24.6 21.8 Q16 29.5 8 28.6" stroke-width="2.1" />
          {/* Nasal pair, running off the far side of the disc. */}
          <path d="M29.6 18.4 Q32.6 15.4 34 13.2" stroke-width="1.5" />
          <path d="M29.6 21.6 Q32.6 24.6 34 26.8" stroke-width="1.5" />
          {/* First bifurcations. */}
          <path d="M17.2 12.6 Q14.2 8.4 11.2 5.9" stroke-width="1.3" />
          <path d="M17.2 27.4 Q14.2 31.6 11.2 34.1" stroke-width="1.3" />
          <path d="M12.9 11.4 Q9.8 13.2 6.6 14.6" stroke-width="1.3" />
          <path d="M12.9 28.6 Q9.8 26.8 6.6 25.4" stroke-width="1.3" />
          {/*
            One fine branch off each arcade, and the single macular vessel
            reaching in towards the centre. Four more were drawn here at
            0.85 units and cut: at the ~37px this renders at, a stroke that
            thin closes up into a grey smudge, and a parallel artery-vein
            pair across the macula read as a mechanical double rule rather
            than as vasculature.
          */}
          <g stroke-width="0.95" opacity=".85">
            <path d="M14.4 9.9 Q12.4 7.6 9.8 6.8" />
            <path d="M14.4 30.1 Q12.4 32.4 9.8 33.2" />
            <path d="M23.6 19.6 Q17.4 18.6 12.4 19.9" />
          </g>
        </g>
        {/* The optic disc: where every vessel in the image originates. */}
        <circle cx="27.1" cy="20" r="3.1" stroke="currentColor" stroke-width="1.5" />
        </g>
      </svg>
    )
  }

  {/*
    Three rod-shaped bacteria — the second pictogram, for the microbiome
    post. Capsules rather than circles so nothing here rhymes with the virus
    two entries up: no rim, no spikes. Three at different angles is the
    fewest that reads as a population rather than a pill; a fourth crowded
    the tile at ~37px. The wavy line is one flagellum, and the faint inner
    dots are the same device the virus uses for its interior, which keeps
    the two pictograms in one family.
  */}
  {
    name === 'microbe' && (
      <svg viewBox="0 0 40 40" fill="none">
        <g stroke="currentColor" stroke-width="1.6">
          <rect x="4" y="7" width="17" height="7" rx="3.5" transform="rotate(-20 12.5 10.5)" />
          <rect x="18" y="17" width="17" height="7" rx="3.5" transform="rotate(25 26.5 20.5)" />
          <rect x="6" y="26" width="15" height="7" rx="3.5" transform="rotate(-8 13.5 29.5)" />
        </g>
        <path d="M21.2 12 q3-2 4 0.5 t4-0.5" stroke="currentColor" stroke-width="1" opacity=".6" />
        <g fill="currentColor" opacity=".55">
          <circle cx="9.5" cy="10.8" r="1.1" />
          <circle cx="14.2" cy="9.2" r="1.1" />
          <circle cx="26" cy="20.4" r="1.1" />
          <circle cx="10.5" cy="29.6" r="1.1" />
          <circle cx="16.2" cy="29" r="1.1" />
        </g>
      </svg>
    )
  }

  {/*
    A capital sigma, for the thesis post — the one entry whose substance is
    a derivation. Drawn as a path rather than set as text so it renders
    identically without a font and takes the same stroke weight as the other
    marks; the short vertical serifs at the two ends are what stop the shape
    reading as an "M" on its side at ~37px.
  */}
  {
    name === 'sigma' && (
      <svg viewBox="0 0 40 40" fill="none">
        <g stroke="currentColor" stroke-width="2.1" stroke-linejoin="round" stroke-linecap="round">
          <path d="M30.5 8.5 H10.5 L21 20 L10.5 31.5 H30.5" />
          <line x1="30.5" y1="8.5" x2="30.5" y2="11.5" />
          <line x1="30.5" y1="31.5" x2="30.5" y2="28.5" />
        </g>
      </svg>
    )
  }
</span>

<style>
  /*
   * Sized by the grid column it sits in rather than fixed, so the entry layout
   * can shrink it on narrow screens without the mark ever having to leave the
   * text's side. Square by aspect-ratio, not by matching width and height.
   */
  .mark {
    width: 100%;
    aspect-ratio: 1;
    color: var(--text-2);
    background: var(--surface-1);
    border: 1px solid var(--line);
    padding: 0.4rem;
  }

  .mark :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

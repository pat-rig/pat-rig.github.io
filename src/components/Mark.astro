---
/*
 * Small data-marks used as the visual anchor beside each entry. They are
 * drawn in `currentColor` so they invert with the theme, and carry no colour
 * of their own — colour stays reserved for the commute visualisation, per
 * docs/design.md.
 *
 * Decorative only: the adjacent title carries the meaning, so each is
 * aria-hidden and adds nothing to the accessibility tree.
 */
export type MarkName = 'grid' | 'distribution' | 'network' | 'bars' | 'fork' | 'lines';

interface Props {
  name: MarkName;
}

const { name } = Astro.props;

// Deterministic opacities for the grid mark: a fixed pattern, not random, so
// the mark renders identically on every build.
const gridCells = [
  0.25, 0.45, 0.2, 0.35, 0.5, 1, 0.75, 0.3, 0.3, 0.6, 0.9, 0.45, 0.15, 0.3, 0.5, 0.2,
];
---

<span class="mark" aria-hidden="true">
  {
    name === 'grid' && (
      <svg viewBox="0 0 40 40" fill="none">
        <g fill="currentColor">
          {gridCells.map((opacity, i) => (
            <rect
              x={1 + (i % 4) * 10}
              y={1 + Math.floor(i / 4) * 10}
              width="8"
              height="8"
              opacity={opacity}
            />
          ))}
        </g>
      </svg>
    )
  }

  {
    name === 'distribution' && (
      <svg viewBox="0 0 40 40" fill="none">
        <path
          d="M2 34 Q10 34 13 22 Q16 6 20 6 Q24 6 27 22 Q30 34 38 34"
          stroke="currentColor"
          stroke-width="2"
        />
        <line
          x1="20"
          y1="6"
          x2="20"
          y2="34"
          stroke="currentColor"
          stroke-width="1"
          opacity=".5"
          stroke-dasharray="2 2"
        />
        <line x1="2" y1="34" x2="38" y2="34" stroke="currentColor" stroke-width="1" opacity=".6" />
      </svg>
    )
  }

  {
    name === 'network' && (
      <svg viewBox="0 0 40 40" fill="none">
        <g stroke="currentColor" stroke-width="1.5" opacity=".7">
          <line x1="8" y1="10" x2="20" y2="20" />
          <line x1="32" y1="8" x2="20" y2="20" />
          <line x1="20" y1="20" x2="10" y2="32" />
          <line x1="20" y1="20" x2="31" y2="30" />
        </g>
        <g fill="currentColor">
          <circle cx="8" cy="10" r="3" />
          <circle cx="32" cy="8" r="2.5" />
          <circle cx="20" cy="20" r="4" />
          <circle cx="10" cy="32" r="2.5" />
          <circle cx="31" cy="30" r="3" />
        </g>
      </svg>
    )
  }

  {
    name === 'bars' && (
      <svg viewBox="0 0 40 40" fill="none">
        <g stroke="currentColor" stroke-width="2">
          <rect x="3" y="6" width="34" height="7" opacity=".8" />
          <rect x="3" y="17" width="24" height="7" opacity=".55" />
          <rect x="3" y="28" width="14" height="7" opacity=".3" />
        </g>
      </svg>
    )
  }

  {
    name === 'fork' && (
      <svg viewBox="0 0 40 40" fill="none">
        <g stroke="currentColor" stroke-width="2" opacity=".7">
          <path d="M4 20 h9" />
          <path d="M27 12 h9" />
          <path d="M27 28 h9" />
          <path d="M13 20 C20 20 20 12 27 12" />
          <path d="M13 20 C20 20 20 28 27 28" />
        </g>
        <g fill="currentColor">
          <circle cx="13" cy="20" r="3" />
          <circle cx="27" cy="12" r="3" />
          <circle cx="27" cy="28" r="3" />
        </g>
      </svg>
    )
  }

  {
    name === 'lines' && (
      <svg viewBox="0 0 40 40" fill="none">
        <g stroke="currentColor" stroke-width="2" opacity=".65">
          <line x1="5" y1="9" x2="35" y2="9" />
          <line x1="5" y1="16" x2="35" y2="16" />
          <line x1="5" y1="23" x2="28" y2="23" />
          <line x1="5" y1="30" x2="20" y2="30" />
        </g>
      </svg>
    )
  }
</span>

<style>
  .mark {
    width: 3.25rem;
    height: 3.25rem;
    flex: none;
    color: var(--text-2);
    background: var(--surface-1);
    border: 1px solid var(--line);
    padding: 0.4rem;
  }

  .mark :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

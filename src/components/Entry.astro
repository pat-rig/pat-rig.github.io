---
import type { CollectionEntry } from 'astro:content';
import Mark from './Mark.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  /** Larger title, used on the full listing pages. */
  prominent?: boolean;
}

const { post, prominent = false } = Astro.props;

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
  timeZone: 'UTC',
});
---

<li class:list={['entry', prominent && 'entry--prominent']}>
  <Mark name={post.data.mark} />
  <div>
    <h3 class="entry__title">
      <a href={`/writing/${post.id}/`}>{post.data.title}</a>
    </h3>
    <p class="entry__summary">{post.data.summary}</p>
    <p class="entry__meta">
      {post.data.kind && <span>{post.data.kind}</span>}
      {
        post.data.status ? (
          <span>{post.data.status}</span>
        ) : (
          <time datetime={post.data.date.toISOString()}>{dateFormat.format(post.data.date)}</time>
        )
      }
    </p>
  </div>
</li>

<style>
  .entry {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-top: 1px solid var(--line);
    align-items: start;
  }

  .entry__title {
    font-size: var(--step-0);
    font-weight: 600;
  }

  .entry--prominent .entry__title {
    font-size: var(--step-1);
  }

  .entry__title a {
    text-decoration-color: var(--line-strong);
  }

  .entry__summary {
    margin-top: var(--space-1);
    color: var(--text-1);
    font-size: var(--step--1);
  }

  .entry--prominent .entry__summary {
    font-size: var(--step-0);
    margin-top: var(--space-2);
  }

  .entry__meta {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-2);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (max-width: 30rem) {
    .entry {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>

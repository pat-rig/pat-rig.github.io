---
/*
 * The reachable-space animation: hills and a bicycle, boarding, a flight past
 * the planets, a cockpit landing. One 3D camera throughout — position, look-at
 * and focal length — so every act shares a single space.
 *
 * Two treatments, switched by `theme`:
 *
 *   paper — the default. No plate at all: the scene is drawn as ink on the page
 *           ground, the way the other figures on this site sit. There is no
 *           starfield, because specks of ink on cream read as dust rather than
 *           as stars — empty paper is the void, and leaving it empty is what
 *           makes the treatment work.
 *   board — the dark plate on `--board`, the token the design system reserves
 *           for a visualisation ground. Keeps the night, the engine glow and
 *           the lit cockpit, at the cost of a visible edge against the page.
 *
 * Both follow docs/design.md rather than inventing a look:
 *
 * - No border, no radius, no shadow. A bordered rounded plate is the
 *   anti-pattern the design doc names, and the figure rule says a box "would
 *   read as a widget pasted into the article".
 * - It runs edge to edge, so it is plainly a band the page passes through
 *   rather than an embed sitting inside the text column. The frame is a
 *   cinematic 2:1: at 5:3 a full-width band is taller than the viewport and the
 *   reader never sees the whole composition at once.
 * - Readouts are `--font-mono`, the site's data face.
 * - Colour comes from the heatmap bins. That is a compromise worth knowing
 *   about: viridis is a *sequential* scale and these five planets are
 *   categories, so two of them sit closer together than ideal. The labels
 *   carry the distinction. Introducing a second accent palette would break the
 *   one-bold-place budget, which seemed the worse trade.
 *
 * Motion: under `prefers-reduced-motion: reduce` nothing animates and nothing
 * is scheduled — a single frame is drawn and a button offers to play it.
 */
interface Props {
  theme?: 'paper' | 'board';
}
const { theme = 'paper' } = Astro.props;
---

<figure class:list={['leap', `leap--${theme}`]} data-agent-leap data-leap-theme={theme}>
  <div class="leap__plate">
    <svg
      class="leap__svg"
      viewBox="0 0 1200 600"
      role="img"
      aria-label="An animation: a cyclist crossing a small range of hills, then boarding a
      starfighter marked AI AGENT and flying past planets labelled CI/CD, Databases, Web apps
      and APIs, before landing on one called Azure."></svg>
    <div class="leap__hud">
      <p class="leap__chapter"><b data-leap-title></b><span data-leap-text></span></p>
    </div>
    <button class="leap__toggle" type="button" data-leap-toggle aria-label="Pause animation">
      Pause
    </button>
  </div>
</figure>

<style>
  /*
   * Edge to edge. `.shell` is `max-width: --width-wide` with `margin-inline:
   * auto`, so it is genuinely centred on the viewport and a child of it can
   * escape symmetrically: the negative margins widen the box by exactly the
   * shell's own margins plus its gutter, which comes out at the full viewport.
   *
   * `width` is left to fall out of the margins rather than being set to
   * `100vw`, because `100vw` counts a classic scrollbar and would push a
   * horizontal one into existence on platforms that have them.
   *
   * A deliberate exception to the template's "nothing breaks out of the
   * column": this is not a diagram beside an argument, it *is* the argument,
   * and at 42rem it would be a postage stamp.
   */
  .leap {
    margin-inline: calc(50% - 50vw);
    margin-block: var(--space-7);
  }

  .leap__plate {
    position: relative;
    /* No border, no radius, no shadow — see the note above. */
    border-radius: var(--radius-0);
  }

  /* Ink on the page ground: no plate, nothing to separate figure from page. */
  .leap--paper .leap__plate {
    background: transparent;
  }

  .leap--board .leap__plate {
    background: var(--board);
  }

  .leap__svg {
    display: block;
    width: 100%;
    height: auto;
    /*
     * Keep the whole composition, and the readouts sitting on it, inside one
     * screenful. When this binds the scene letterboxes horizontally, into the
     * plate's own ground — so the seam is invisible either way.
     */
    max-height: 78vh;
  }

  .leap__hud {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    /*
     * Indent to the shell's own edge, so the readouts line up with the masthead
     * and the article rather than floating against the raw screen edge.
     */
    padding: var(--space-4) max(var(--gutter), calc((100vw - var(--width-wide)) / 2 + var(--gutter)));
    pointer-events: none;
  }

  .leap__chapter {
    margin: 0;
  }

  .leap__chapter b {
    display: block;
    font-size: var(--step--1);
    color: var(--text-0);
  }

  .leap--board .leap__chapter b {
    color: #e7eaee;
  }

  .leap__chapter span {
    font-size: var(--step--1);
    color: var(--text-1);
  }

  .leap--board .leap__chapter span {
    color: #a6aebb;
  }

  .leap__toggle {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    font: inherit;
    font-size: var(--step--1);
    font-family: var(--font-mono);
    color: var(--text-1);
    background: transparent;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-1);
    padding: var(--space-1) var(--space-3);
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease);
  }

  .leap--board .leap__toggle {
    color: #e7eaee;
    border-color: #626c79;
  }

  .leap__plate:hover .leap__toggle,
  .leap__toggle:focus-visible {
    opacity: 1;
  }

  /*
   * With motion reduced the control is the only way in, and on a touch screen
   * there is no hover to reveal it — so in both cases it simply stays visible.
   */
  @media (prefers-reduced-motion: reduce), (hover: none) {
    .leap__toggle {
      opacity: 1;
    }
  }

</style>

<style is:global>
  /*
   * The scene's contents are built in JavaScript, so they carry no scoping
   * attribute and a scoped rule would never reach them.
   */
  .leap__svg text.leap-label {
    font-family: var(--font-sans);
    font-weight: 600;
  }

  .leap__svg text.leap-mono {
    font-family: var(--font-mono);
  }
</style>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  type Vec = [number, number, number];

  const el = (n: string, a: Record<string, string | number> = {}, p?: Element) => {
    const e = document.createElementNS(NS, n);
    for (const k in a) e.setAttribute(k, String(a[k]));
    if (p) p.appendChild(e);
    return e;
  };
  const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  const smooth = (e0: number, e1: number, x: number) => {
    const t = clamp((x - e0) / (e1 - e0), 0, 1);
    return t * t * (3 - 2 * t);
  };
  const setShown = (g: Element, on: boolean) =>
    on ? g.removeAttribute('display') : g.setAttribute('display', 'none');

  const sub = (a: Vec, b: Vec): Vec => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];
  const add = (a: Vec, b: Vec): Vec => [a[0] + b[0], a[1] + b[1], a[2] + b[2]];
  const mul = (a: Vec, s: number): Vec => [a[0] * s, a[1] * s, a[2] * s];
  const dot = (a: Vec, b: Vec) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
  const cross = (a: Vec, b: Vec): Vec => [
    a[1] * b[2] - a[2] * b[1],
    a[2] * b[0] - a[0] * b[2],
    a[0] * b[1] - a[1] * b[0],
  ];
  const norm = (a: Vec): Vec => {
    const l = Math.hypot(a[0], a[1], a[2]) || 1;
    return [a[0] / l, a[1] / l, a[2] / l];
  };
  const lerp3 = (a: Vec, b: Vec, t: number): Vec => [
    lerp(a[0], b[0], t),
    lerp(a[1], b[1], t),
    lerp(a[2], b[2], t),
  ];

  /* Heatmap bins (§6.1) reused as the scene's palette. */
  const BIN = {
    b1: '#3b528b',
    b2: '#31688e',
    b3: '#21918c',
    b4: '#27ad81',
    b5: '#5ec962',
    b6: '#fde725',
  };
  /*
   * Every colour the scene uses, per treatment. Named by role rather than by
   * value so the two themes stay in step: anything added here has to be given a
   * meaning in both, which is what stops the paper version quietly inheriting a
   * near-black from the dark one.
   */
  const THEMES = {
    board: {
      ink: '#e7eaee', dim: '#8c95a3', outline: '#a6aebb', metal: '#7f93b8',
      void: '#05070e', panel: '#141a24',
      terrLow: '#0f1720', terrHigh: BIN.b4, terrStroke: BIN.b3, contour: BIN.b5,
      cockFill: '#0a0f1a', cockFrame: '#6f88b4', hudFill: '#14171c',
      hudStroke: '#2a313b', gaugeTrack: '#1b2740', flash: '#dff1ff',
      hullFill: '#e7eaee', planetFill: 0.18, stars: true, starShape: 'dot', glow: 0.9,
      accent: BIN.b6, haze: 0.3, monoPlanets: false,
      wing: BIN.b3, wingLit: BIN.b4, wingEdge: BIN.b5, canopy: BIN.b5,
    },
    paper: {
      ink: '#1f1b14', dim: '#645d47', outline: '#1f1b14', metal: '#7d7157',
      void: '#f4f1ea', panel: '#ece7dc',
      terrLow: '#f4f1ea', terrHigh: BIN.b3, terrStroke: '#1f1b14', contour: '#55503f',
      cockFill: '#f4f1ea', cockFrame: '#1f1b14', hudFill: '#ece7dc',
      hudStroke: '#d3c9b4', gaugeTrack: '#e1dacb', flash: '#ffffff',
      hullFill: '#f4f1ea', planetFill: 0.1, stars: true, starShape: 'asterisk', glow: 0.28,
      accent: BIN.b1, haze: 0.12, monoPlanets: true,
      wing: '#e1dacb', wingLit: '#d3c9b4', wingEdge: '#1f1b14', canopy: BIN.b1,
    },
  } as const;

  const CX = 600,
    CY = 300,
    F = 880;
  /*
   * proj() returns F/z — pixels per world unit at that depth. Sprite art is
   * drawn in its own local units, so each needs its own art-units-per-world-unit
   * factor on top of that.
   */
  const S_NODE = 0.34,
    S_BIKE = 0.18,
    S_WALK = 0.22,
    S_SHIP = 0.13;

  const COLS = 22,
    ROWS = 15;
  const TX0 = -78,
    TX1 = 78,
    TZ0 = 14,
    TZ1 = 182;
  const gx = (i: number) => lerp(TX0, TX1, i / COLS);
  const gz = (j: number) => lerp(TZ0, TZ1, j / ROWS);

  /*
   * The ground act now covers a whole build — ride, fell, barrow the logs to the
   * mill, barrow the planks back, raise the hut — so it runs to 19.5s and the
   * film to 47.5s. Everything after launch keeps its original 22.6s of flight
   * and 5.4s of landing.
   */
  const T_RIDE = 4,
    T_FELL = 5.2,
    /* the barrow is fetched after the tree is down, not while it is falling */
    T_BARROW = 7,
    T_LOADED = 7.8,
    T_ATMILL = 9.8,
    T_MILLED = 11.2,
    /* planks alone do not make a house: hinges, nails, tools come off the bench */
    T_ATBENCH = 13.2,
    T_FITTED = 14.6,
    T_ATSITE = 16.6,
    T_BUILT = 18.6,
    /* then the finished hut simply sits there, long enough to register */
    T_ARRIVE = 20.4,
    T_DOWN = 22.2,
    T_OFF = 22.6,
    T_BOARD = 24.6,
    T_LAUNCH = 25.6,
    T_COCK = 43.6,
    T_TOUCH = 48.2,
    T_TEAM = 49.1,
    T_FENCE = 49.5,
    T_RISE = 50.5,
    /* the camera stops here; everything after is the film holding its last frame */
    T_SETTLE = 55.5,
    DUR = 60.2;
  /* The frame drawn when motion is reduced: the ship abeam of a planet. */
  const STILL_T = 22.6;

  function hHome(x: number, z: number) {
    const g = (cx: number, cz: number, a: number, s: number) =>
      a * Math.exp(-((x - cx) ** 2 + (z - cz) ** 2) / (2 * s * s));
    return (
      g(-34, 74, 17, 27) +
      g(30, 116, 14, 23) +
      g(4, 158, 9, 30) +
      g(58, 48, 11, 17) +
      1.6 * Math.sin(x * 0.09) * Math.cos(z * 0.07)
    );
  }
  const hAzure = (x: number, z: number) =>
    2.2 * Math.sin(x * 0.05) * Math.cos(z * 0.04) + 1.4 * Math.sin(z * 0.09);

  /* Mixes two hex colours, so the terrain ramps along the bins. */
  function mix(a: string, b: string, t: number) {
    const p = (h: string) => [
      parseInt(h.slice(1, 3), 16),
      parseInt(h.slice(3, 5), 16),
      parseInt(h.slice(5, 7), 16),
    ];
    const [r1, g1, b1] = p(a),
      [r2, g2, b2] = p(b);
    const c = (x: number, y: number) => Math.round(lerp(x, y, clamp(t, 0, 1)));
    return `rgb(${c(r1, r2)} ${c(g1, g2)} ${c(b1, b2)})`;
  }

  /* `c` is filled in per treatment in build() — the home world is drawn in the
     scene's own neutral rather than one of the accent bins. */
  const HOMEP = { pos: [0, -330, 80] as Vec, r: 300, c: '#8c95a3', name: 'my laptop' };
  const PLANETS = [
    { name: 'CI / CD', pos: [-400, 60, 980] as Vec, r: 120, c: BIN.b6, motif: 'arcs' },
    { name: 'Databases', pos: [480, -80, 1760] as Vec, r: 145, c: BIN.b4, motif: 'discs' },
    { name: 'Web apps', pos: [-450, 120, 2540] as Vec, r: 130, c: BIN.b1, motif: 'panes' },
    { name: 'APIs & infra', pos: [430, 190, 3320] as Vec, r: 110, c: BIN.b5, motif: 'hex' },
    { name: 'Azure', pos: [0, -30, 4520] as Vec, r: 300, c: BIN.b2, motif: 'grid' },
  ];
  /*
   * The planets flank the corridor and the ship threads between them, coming no
   * closer than about three radii. An earlier layout put the waypoints on the
   * planet centres, which read as flying into them rather than past them.
   * Azure is the exception: that one is the destination, so it is dead ahead.
   */
  const FLY: Vec[] = [
    [0, 26, 70],
    [10, 90, 260],
    [-30, 120, 560],
    [-60, 110, 860],
    [-40, 70, 1180],
    [40, 20, 1480],
    [85, -15, 1760],
    [60, 15, 2060],
    [-20, 65, 2340],
    [-45, 95, 2540],
    [-10, 115, 2860],
    [40, 145, 3160],
    [55, 155, 3320],
    [30, 110, 3640],
    [10, 40, 3960],
    [0, 0, 4180],
    [0, -15, 4230],
  ];
  /*
   * The hills are one small data project told as a timber chain, and the bicycle
   * rides past it in order: trees are the raw material, the mill performs the
   * same transform on everything fed into it, the bench is where things get
   * tried and thrown away. What comes out is a hut — the biggest thing one
   * person builds from what is within a day's ride.
   *
   * The payoff is on Azure, where the same craft is putting up a city.
   * Deliberately the same timber language, at a size the hills cannot reach.
   */
  const PROPS = [
    { x: -60, z: 96, world: 'home', kind: 'forest', h: 34, label: 'raw data' },
    { x: 6, z: 132, world: 'home', kind: 'mill', h: 27, label: 'preprocessing' },
    { x: 64, z: 92, world: 'home', kind: 'bench', h: 27, label: 'experiments' },
    { x: 6, z: 60, world: 'home', kind: 'hut', h: 27, label: 'what I could build without agents' },
    /*
     * Azure rhymes with the hills rather than just outscaling them: the same
     * craft, but several things going up at once while he stands and watches.
     * Two of these are deliberately not buildings — security is the perimeter
     * around everything, and CI/CD is a hoist that never stops cycling — because
     * neither is a component you finish.
     */
    { x: 2, z: 124, world: 'azure', kind: 'tower', th: 74, rows: 5, h: 74, label: 'data' },
    { x: 24, z: 142, world: 'azure', kind: 'tower', th: 104, rows: 7, h: 104, label: 'model' },
    { x: 46, z: 126, world: 'azure', kind: 'tower', th: 68, rows: 5, h: 68, label: 'API' },
    { x: 68, z: 110, world: 'azure', kind: 'tower', th: 56, rows: 4, h: 56, label: 'web app' },
    { x: 34, z: 120, world: 'azure', kind: 'site', h: 0, label: '' },
    /* carries no art — it exists only to place the closing line, clear of the
       skyline and away from the tower labels */
    { x: 58, z: 116, world: 'azure', kind: 'title', h: 112, lmul: 1.45, label: 'what I can build with agents' },
  ];
  const CHAPTERS = [
    { t: 0, title: 'Before agents', text: 'A few hills, reachable at pedalling speed.' },
    { t: 5.2, title: 'Raw material', text: 'Everything starts as something you have to go and fell.' },
    { t: 9.8, title: 'Through the mill', text: 'The same cut, applied to everything you feed it.' },
    { t: 13.2, title: 'Fittings', text: 'And the parts that never came out of a log.' },
    { t: 16.6, title: 'Building', text: 'Then you put it up yourself, one piece at a time.' },
    { t: 18.8, title: 'A day’s work', text: 'One person, one thing at a time, and this is where it ends.' },
    { t: 20.6, title: 'AI AGENT', text: 'Something comes down on the hill beside it.' },
    { t: 25.8, title: 'With agents', text: 'Same human. The range is what changed.' },
    { t: 29.1, title: 'Passing through', text: 'Each of these was out of reach on a bicycle.' },
    { t: 43.8, title: 'Approach', text: 'Fuel costs money. You pick the trips worth taking.' },
    { t: 48.8, title: 'You are not the one building', text: 'They fan out. He stands still.' },
    {
      t: 54.6,
      title: 'The same craft',
      text: 'In parallel, behind a fence, on a hoist that never stops.',
    },
  ];

  function catmull(P: Vec[], s: number): Vec {
    const n = P.length - 1,
      x = clamp(s, 0, 1) * n;
    const i = Math.min(Math.floor(x), n - 1),
      f = x - i;
    const p0 = P[Math.max(i - 1, 0)],
      p1 = P[i],
      p2 = P[i + 1],
      p3 = P[Math.min(i + 2, n)];
    const f2 = f * f,
      f3 = f2 * f;
    const out = [0, 0, 0];
    for (let k = 0; k < 3; k++)
      out[k] =
        0.5 *
        (2 * p1[k] +
          (-p0[k] + p2[k]) * f +
          (2 * p0[k] - 5 * p1[k] + 4 * p2[k] - p3[k]) * f2 +
          (-p0[k] + 3 * p1[k] - 3 * p2[k] + p3[k]) * f3);
    return out as Vec;
  }

  function build(root: HTMLElement) {
    const T = THEMES[root.dataset.leapTheme === 'board' ? 'board' : 'paper'];
    const INK = T.ink,
      DIM = T.dim;
    HOMEP.c = T.dim;
    /*
     * On paper every planet is drawn in ink and told apart by its motif and its
     * label. The light end of viridis — the yellows and greens the dark
     * treatment leans on — has almost no contrast against cream, so colour
     * cannot carry the distinction here and the motifs have to.
     */
    if (T.monoPlanets) for (const p of PLANETS) p.c = T.ink;
    const svg = root.querySelector('.leap__svg') as SVGSVGElement;
    const titleEl = root.querySelector('[data-leap-title]') as HTMLElement;
    const textEl = root.querySelector('[data-leap-text]') as HTMLElement;
    const toggle = root.querySelector('[data-leap-toggle]') as HTMLButtonElement;

    /* arc-length table, so the ship holds a steady speed through the turns */
    const NSAMP = 800;
    const LUT = [0];
    let prevP = catmull(FLY, 0),
      TOTAL = 0;
    for (let k = 1; k <= NSAMP; k++) {
      const p = catmull(FLY, k / NSAMP);
      TOTAL += Math.hypot(p[0] - prevP[0], p[1] - prevP[1], p[2] - prevP[2]);
      LUT.push(TOTAL);
      prevP = p;
    }
    const flyAt = (frac: number) => {
      const target = clamp(frac, 0, 1) * TOTAL;
      let lo = 0,
        hi = NSAMP;
      while (lo < hi) {
        const m = (lo + hi) >> 1;
        if (LUT[m] < target) lo = m + 1;
        else hi = m;
      }
      return catmull(FLY, lo / NSAMP);
    };

    const defs = el('defs', {}, svg);
    const glow = el('radialGradient', { id: 'leapGlow' }, defs);
    el('stop', { offset: '0%', 'stop-color': T.accent, 'stop-opacity': String(T.glow) }, glow);
    el('stop', { offset: '100%', 'stop-color': BIN.b6, 'stop-opacity': '0' }, glow);
    const haze = el('radialGradient', { id: 'leapHaze' }, defs);
    el('stop', { offset: '0%', 'stop-color': T.monoPlanets ? T.dim : BIN.b3, 'stop-opacity': String(T.haze) }, haze);
    el('stop', { offset: '100%', 'stop-color': T.monoPlanets ? T.dim : BIN.b3, 'stop-opacity': '0' }, haze);
    for (const p of [...PLANETS, HOMEP]) {
      const id = 'leapP' + p.name.replace(/\W/g, '');
      const rg = el('radialGradient', { id, cx: '0.36', cy: '0.32', r: '0.78' }, defs);
      el('stop', { offset: '0%', 'stop-color': p.c, 'stop-opacity': String(T.planetFill * 3.4) }, rg);
      el('stop', { offset: '62%', 'stop-color': p.c, 'stop-opacity': String(T.planetFill) }, rg);
      el('stop', { offset: '100%', 'stop-color': T.void, 'stop-opacity': '0.92' }, rg);
      (p as { grad?: string }).grad = `url(#${id})`;
    }

    const gStars = el('g', {}, svg);
    const gSpace = el('g', {}, svg);
    const gHaze = el('g', {}, svg);
    const gTerr = el('g', {}, svg);
    const gProps = el('g', {}, svg);
    const gShipR = el('g', { opacity: 0 }, svg);
    const gCock = el('g', { opacity: 0 }, svg);
    const gFlash = el('g', {}, svg);

    let seed = 11;
    const rnd = () => (seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648;
    /*
     * On the dark treatment a star is a dot. On paper a dot is a speck of dirt,
     * so a star is drawn as a six-point asterisk instead — a typographic mark,
     * which is legible as a star at a size a dot would just look like grime.
     * Fewer of them too: asterisks carry far more ink than dots.
     */
    const ASTERISK =
      'M -1 0 L 1 0 M -0.5 -0.866 L 0.5 0.866 M -0.5 0.866 L 0.5 -0.866';
    const asterisks = T.starShape === 'asterisk';
    const STARS: { p: Vec; b: number; rot: number; el: Element }[] = [];
    for (let i = 0; T.stars && i < (asterisks ? 150 : 420); i++)
      STARS.push({
        p: [(rnd() - 0.5) * 5200, (rnd() - 0.5) * 3200, rnd() * 5600 - 400],
        b: 0.7 + rnd() * 2.1,
        rot: rnd() * 60,
        el: asterisks
          ? el(
              'path',
              {
                d: ASTERISK,
                fill: 'none',
                stroke: T.ink,
                'stroke-width': 0.26,
                'stroke-linecap': 'round',
                opacity: 0,
              },
              gStars
            )
          : el('circle', { cx: -99, cy: -99, r: 1, fill: INK }, gStars),
      });
    const hideStar = (st: { el: Element }) =>
      asterisks ? st.el.setAttribute('opacity', '0') : st.el.setAttribute('r', '0');

    type P = (typeof PLANETS)[number] & {
      g?: Element;
      base?: Element;
      disc?: Element;
      rim?: Element;
      motifG?: Element;
      label?: Element;
      grad?: string;
    };
    const ALL = [...PLANETS, HOMEP] as P[];
    for (const p of ALL) {
      p.g = el('g', {}, gSpace);
      /* Solid base first: the gradient alone is ~20% opaque mid-disc, and the
         starfield behind would otherwise shine straight through the planet. */
      p.base = el('circle', { cx: 0, cy: 0, r: 1, fill: T.void }, p.g);
      p.disc = el('circle', { cx: 0, cy: 0, r: 1, fill: T.monoPlanets ? 'none' : p.grad! }, p.g);
      p.rim = el(
        'circle',
        { cx: 0, cy: 0, r: 1, fill: 'none', stroke: p.c, 'stroke-width': 2, opacity: 0.9 },
        p.g
      );
      p.motifG = el('g', {}, p.g);
      p.label = el('text', { 'text-anchor': 'middle', fill: p.c, class: 'leap-label' }, p.g);
      p.label.textContent = p.name;
    }
    function drawMotif(p: P, R: number) {
      const m = p.motifG!;
      while (m.firstChild) m.removeChild(m.firstChild);
      const st = {
        fill: 'none',
        stroke: p.c,
        'stroke-width': Math.max(R * 0.012, 0.6),
        opacity: 0.55,
      };
      const band = (k: number) => R * Math.sqrt(Math.max(0, 1 - (0.31 * k) ** 2)) * 0.95;
      if (p.motif === 'discs')
        for (let k = -2; k <= 2; k++)
          el('ellipse', { cx: 0, cy: R * 0.31 * k, rx: band(k), ry: R * 0.11, ...st }, m);
      else if (p.motif === 'arcs')
        for (let k = 1; k <= 3; k++) el('circle', { cx: 0, cy: 0, r: (R * k) / 3.6, ...st }, m);
      else if (p.motif === 'panes')
        for (let k = -1; k <= 1; k++) {
          el(
            'line',
            { x1: R * 0.55 * k, y1: -R * 0.82, x2: R * 0.55 * k, y2: R * 0.82, ...st },
            m
          );
          el(
            'line',
            { x1: -R * 0.82, y1: R * 0.55 * k, x2: R * 0.82, y2: R * 0.55 * k, ...st },
            m
          );
        }
      else if (p.motif === 'hex') {
        for (let k = 0; k < 6; k++) {
          const a = (k * Math.PI) / 3;
          el(
            'line',
            { x1: 0, y1: 0, x2: R * 0.86 * Math.cos(a), y2: R * 0.86 * Math.sin(a), ...st },
            m
          );
        }
        el('circle', { cx: 0, cy: 0, r: R * 0.45, ...st }, m);
      } else
        for (let k = -2; k <= 2; k++) {
          el('ellipse', { cx: 0, cy: R * 0.31 * k, rx: band(k), ry: R * 0.1, ...st }, m);
          el('ellipse', { cx: R * 0.31 * k, cy: 0, rx: R * 0.1, ry: band(k), ...st }, m);
        }
    }

    const hz = el('ellipse', { cx: CX, cy: 0, rx: 1, ry: 1, fill: 'url(#leapHaze)' }, gHaze);
    /* Far enough away that it barely parallaxes, which is what a sun does. It
       lives behind the terrain, so the hills cut across it. */
    const SUN_AT: Vec = [-300, 30, 560];
    const sun = el('circle', { cx: -99, cy: -99, r: 1, fill: 'none', stroke: T.ink, 'stroke-width': 1.2, opacity: 0 }, gHaze);
    const QUADS: { i: number; j: number; el: Element }[] = [];
    for (let j = ROWS - 1; j >= 0; j--)
      for (let i = 0; i < COLS; i++)
        QUADS.push({
          i,
          j,
          el: el(
            'path',
            { d: '', stroke: T.terrStroke, 'stroke-width': 0.5, 'stroke-opacity': 0.28 },
            gTerr
          ),
        });
    const CONTOURS: { j: number; el: Element }[] = [];
    for (let j = 0; j <= ROWS; j += 3)
      CONTOURS.push({
        j,
        el: el(
          'path',
          { d: '', fill: 'none', stroke: T.contour, 'stroke-width': 1.1, opacity: 0.4 },
          gTerr
        ),
      });

    /* Silhouettes in local units, origin at ground contact, a standing human
       about 23 units tall for scale. */
    const line = { fill: 'none', stroke: T.ink, 'stroke-width': 1.1, 'stroke-linejoin': 'round', 'stroke-linecap': 'round' };
    const solid = { fill: T.panel, stroke: T.ink, 'stroke-width': 1.1, 'stroke-linejoin': 'round' };

    /* Handles for the parts that move: a tree that comes down, the piles that
       appear and go, and the hut that goes up in stages. */
    type Handles = Partial<
      Record<
        | 'falling'
        | 'logs'
        | 'planks'
        | 'parts'
        | 'walls'
        | 'roof'
        | 'trim'
        | 'body'
        | 'fence'
        | 'hoist',
        Element
      >
    >;

    function tree(g: Element, x: number, h: number, tag: boolean) {
      const w = h * 0.26;
      el('path', { d: `M ${x} 0 L ${x} ${-h * 0.24}`, ...line }, g);
      el('path', { d: `M ${x} ${-h * 0.6} L ${x + w * 1.35} 0 L ${x - w * 1.35} 0 Z`, ...solid }, g);
      el('path', { d: `M ${x} ${-h} L ${x + w} ${-h * 0.44} L ${x - w} ${-h * 0.44} Z`, ...solid }, g);
      /* a ribbon on a tree is a labelled example */
      if (tag) el('rect', { x: x + w * 0.5, y: -h * 0.72, width: 3.2, height: 2.1, fill: T.accent }, g);
    }
    function logPile(g: Element, x: number) {
      const p = el('g', { opacity: 0 }, g);
      for (const [lx, ly] of [
        [x - 3.2, -3],
        [x + 3.2, -3],
        [x, -8.2],
      ])
        el('circle', { cx: lx, cy: ly, r: 3.2, ...solid }, p);
      return p;
    }
    function plankPile(g: Element, x: number) {
      const p = el('g', { opacity: 0 }, g);
      for (let k = 0; k < 3; k++)
        el('rect', { x: x - 7, y: -3.4 * (k + 1), width: 14, height: 2.6, ...solid }, p);
      return p;
    }

    function drawProp(g: Element, kind: string, n: { th?: number; rows?: number }): Handles {
      const h: Handles = {};
      if (kind === 'forest') {
        tree(g, -15, 25, false);
        tree(g, -5, 34, true);
        tree(g, 5, 22, false);
        /* this one comes down; its own group so it can hinge at the stump */
        h.falling = el('g', {}, g);
        tree(h.falling, 15, 30, true);
        h.logs = logPile(g, 24);
      } else if (kind === 'mill') {
        el('path', { d: 'M -14 0 L -14 -17 L 14 -17 L 14 0 Z', ...solid }, g);
        el('path', { d: 'M -17 -17 L 0 -27 L 17 -17 Z', ...solid }, g);
        el('path', { d: 'M -4 0 L -4 -9 L 4 -9 L 4 0', ...line }, g);
        /*
         * No saw blade. A toothed disc beside the building read as a rising sun
         * however it was sized or placed, and the label plus the planks stacked
         * outside already say what happens here. A ramp says the rest: material
         * goes in at one end.
         */
        el('path', { d: 'M -14 -4 L -23 0', ...line }, g);
        el('path', { d: 'M -14 -8 L -23 -4', ...line }, g);
        h.planks = plankPile(g, 22);
      } else if (kind === 'bench') {
        el('path', { d: 'M -12 0 L -12 -9 M 12 0 L 12 -9', ...line }, g);
        el('rect', { x: -15, y: -12, width: 30, height: 3, ...solid }, g);
        /* offcuts: the things that did not work */
        el('rect', { x: -9, y: -16, width: 7, height: 4, ...solid }, g);
        el('rect', { x: 2, y: -15, width: 5, height: 3, ...solid }, g);
        el('path', { d: 'M -17 -20 L 0 -27 L 17 -20', ...line }, g);
        /* fittings, laid out ready to be carried off */
        h.parts = el('g', { opacity: 0 }, g);
        for (const px of [-8, -1, 6])
          el('rect', { x: px, y: -18.4, width: 4.4, height: 3.4, ...solid }, h.parts);
        el('path', { d: 'M 12 -15 L 12 -19 M 10 -19 L 14 -19', ...line }, h.parts);
      } else if (kind === 'hut') {
        /* three stages, so the hut is watched going up rather than just being there */
        h.walls = el('g', { opacity: 0 }, g);
        el('path', { d: 'M -12 0 L -12 -13 L 12 -13 L 12 0 Z', ...solid }, h.walls);
        h.roof = el('g', { opacity: 0 }, g);
        el('path', { d: 'M -15 -13 L 0 -23 L 15 -13 Z', ...solid }, h.roof);
        h.trim = el('g', { opacity: 0 }, g);
        el('path', { d: 'M -4 0 L -4 -8 L 4 -8 L 4 0', ...line }, h.trim);
        el('rect', { x: 6, y: -27, width: 4, height: 7, ...solid }, h.trim);
      } else if (kind === 'tower') {
        /* grows out of the ground, so scaling the group upward raises it */
        const th = n.th ?? 60,
          rows = n.rows ?? 4;
        h.body = el('g', {}, g);
        el('rect', { x: -11, y: -th, width: 22, height: th, ...solid }, h.body);
        for (let r = 1; r <= rows; r++) {
          const y = -th + (th / (rows + 1)) * r;
          el('path', { d: `M -7 ${y} L 7 ${y}`, ...line, opacity: 0.5 }, h.body);
        }
        /* the crane that put it there stays up beside it */
        el('path', { d: `M 17 0 L 17 ${-th - 16}`, ...line, opacity: 0.75 }, h.body);
        el('path', { d: `M 5 ${-th - 10} L 34 ${-th - 10}`, ...line, opacity: 0.75 }, h.body);
        el('path', { d: `M 28 ${-th - 10} L 28 ${-th + 2}`, ...line, opacity: 0.45 }, h.body);
      } else {
        /* Security is not a building — it is the line drawn around everything. */
        h.fence = el('path', {
          d: 'M -104 14 L 104 14 L 122 -12 L -122 -12 Z',
          fill: 'none',
          stroke: T.accent,
          'stroke-width': 1.4,
          'stroke-dasharray': '7 5',
          opacity: 0,
        }, g);
        /* CI/CD is not a building either — it is the thing that never stops. */
        h.hoist = el('g', {}, g);
        el('path', { d: 'M 0 4 L 0 -78', ...line, opacity: 0.7 }, h.hoist);
        el('rect', { x: -5, y: -12, width: 10, height: 8, ...solid, class: 'leap-car' }, h.hoist);
      }
      return h;
    }

    const NODEG = PROPS.map((n) => {
      const g = el('g', {}, gProps);
      const wide = n.kind === 'site' || n.kind === 'title';
      const shadowOp = n.kind === 'site' || n.kind === 'title' ? 0 : T.stars ? 0.42 : 0.12;
      const shadow = el('ellipse', { cx: 0, cy: 0, rx: wide ? 62 : 13, ry: 3.4, fill: '#000', opacity: shadowOp }, g);
      const h = n.kind === 'title' ? {} : drawProp(g, n.kind, n as { th?: number; rows?: number });
      const t = el(
        'text',
        { x: 0, y: -(n.h + 11), 'text-anchor': 'middle', fill: T.accent, 'font-size': 6.4, class: 'leap-label' },
        g
      );
      t.textContent = n.label;
      return { g, h, label: t, shadow, shadowOp };
    });
    const HUT_NODE = NODEG[3];
    const FOREST = NODEG[0].h,
      MILL = NODEG[1].h,
      BENCH = NODEG[2].h,
      HUT = NODEG[3].h,
      HUT_LABEL = NODEG[3].label;
    /* the four towers, then the site furniture */
    const TOWERS = [4, 5, 6, 7].map((i) => ({ node: NODEG[i], prop: PROPS[i] }));
    const SITE = NODEG[PROPS.findIndex((p) => p.kind === 'site')].h;
    const TITLE_NODE = NODEG[PROPS.findIndex((p) => p.kind === 'title')];

    /* the barrow: one wheel, two handles, and whatever it is carrying */
    const barrowG = el('g', { opacity: 0 }, gProps);
    el('path', { d: 'M -9 -10 L 9 -10 L 7 -4 L -7 -4 Z', ...solid }, barrowG);
    el('path', { d: 'M -9 -10 L -15 -13 M 9 -7 L 14 -3', ...line }, barrowG);
    el('circle', { cx: 8, cy: -2.6, r: 2.6, ...solid }, barrowG);
    const barrowLogs = el('g', { opacity: 0 }, barrowG);
    for (const lx of [-4, 0, 4]) el('circle', { cx: lx, cy: -12.4, r: 2.5, ...solid }, barrowLogs);
    const barrowPlanks = el('g', { opacity: 0 }, barrowG);
    for (let k = 0; k < 2; k++)
      el('rect', { x: -8, y: -13.4 - k * 2.6, width: 16, height: 2.2, ...solid }, barrowPlanks);
    const barrowParts = el('g', { opacity: 0 }, barrowG);
    for (const px of [-6, -1, 4]) el('rect', { x: px, y: -14, width: 4, height: 3.2, ...solid }, barrowParts);
    el('path', { d: 'M 8 -11 L 8 -16 M 6 -16 L 10 -16', ...line }, barrowParts);

    const bikeG = el('g', {}, gProps);
    const bikeShadow = el('ellipse', { cx: 0, cy: 0, rx: 11, ry: 3.4, fill: '#000', opacity: 0.4 }, bikeG);
    const bikeTilt = el('g', {}, bikeG);
    const bikeLean = el('g', {}, bikeTilt);
    const bikeOnly = el('g', {}, bikeLean);
    const spokes = el('g', {}, bikeOnly);
    el('path', { d: 'M -7 -6 L -7 -12 M -13 -6 L -1 -6', stroke: INK, 'stroke-width': 1 }, spokes);
    el('circle', { cx: -7, cy: -6, r: 6, fill: 'none', stroke: INK, 'stroke-width': 1.3 }, bikeOnly);
    el('circle', { cx: 7, cy: -6, r: 6, fill: 'none', stroke: INK, 'stroke-width': 1.3 }, bikeOnly);
    el(
      'path',
      {
        d: 'M -7 -6 L 0 -11 L 7 -6 M 0 -11 L 2.6 -14',
        fill: 'none',
        stroke: INK,
        'stroke-width': 1.3,
        'stroke-linejoin': 'round',
      },
      bikeOnly
    );
    const riderOnBike = el('g', {}, bikeLean);
    el('circle', { cx: 1, cy: -23, r: 3.6, fill: T.accent }, riderOnBike);
    el(
      'path',
      {
        d: 'M 1 -19.6 L 1 -12.4 M 1 -18 L 4.4 -14.4 M 1 -12.4 L -1.6 -9',
        fill: 'none',
        stroke: T.accent,
        'stroke-width': 1.4,
        'stroke-linecap': 'round',
      },
      riderOnBike
    );

    function makeWalker(parent: Element) {
      const g = el('g', { opacity: 0 }, parent);
      el('circle', { cx: 0, cy: -23, r: 3.6, fill: T.accent }, g);
      el('path', { d: 'M 0 -19.4 L 0 -9', stroke: T.accent, 'stroke-width': 1.5, 'stroke-linecap': 'round' }, g);
      const mk = (w: number) =>
        el('path', { stroke: T.accent, 'stroke-width': w, 'stroke-linecap': 'round' }, g);
      return { g, aL: mk(1.3), aR: mk(1.3), lL: mk(1.5), lR: mk(1.5) };
    }
    type Walker = ReturnType<typeof makeWalker>;
    function poseWalker(w: Walker, phase: number, moving: boolean) {
      const sw = moving ? Math.sin(phase) * 4.2 : 0;
      w.lL.setAttribute('d', `M 0 -9 L ${(-2.6 - sw).toFixed(1)} 0`);
      w.lR.setAttribute('d', `M 0 -9 L ${(2.6 + sw).toFixed(1)} 0`);
      w.aL.setAttribute('d', `M 0 -17 L ${(-3.4 + sw * 0.7).toFixed(1)} -11`);
      w.aR.setAttribute('d', `M 0 -17 L ${(3.4 - sw * 0.7).toFixed(1)} -11`);
    }
    const walkerHome = makeWalker(gProps);
    const walkerAz = makeWalker(gProps);
    /* One agent per tower. They are drawn exactly like him, because the point is
       that it is the same work — there is just more of it happening at once. */
    const AGENTS = [0, 1, 2, 3].map(() => makeWalker(gProps));

    const shipG = el('g', { opacity: 0 }, gProps);
    const shipShadow = el('ellipse', { cx: 0, cy: 2, rx: 52, ry: 8, fill: '#000', opacity: 0.45 }, shipG);
    const shipBody = el('g', {}, shipG);
    const wingStyle = { stroke: T.wingEdge, 'stroke-width': 1.6, 'stroke-linejoin': 'round' };
    el('path', { d: 'M 20 -14 L 2 -52 L -26 -52 L -24 -14 Z', fill: T.wing, ...wingStyle }, shipBody);
    el('path', { d: 'M 2 -52 L -6 -66 L -24 -66 L -26 -52 Z', fill: T.wingLit, ...wingStyle }, shipBody);
    el(
      'path',
      {
        d: 'M 70 -22 L 34 -30 L -34 -34 L -46 -30 L -46 -14 L -34 -10 L 34 -14 Z',
        fill: T.hullFill,
        stroke: T.outline,
        'stroke-width': 2,
        'stroke-linejoin': 'round',
      },
      shipBody
    );
    el('path', { d: 'M 30 -26 L -36 -29', stroke: T.accent, 'stroke-width': 2.4, opacity: 0.9 }, shipBody);
    el(
      'path',
      { d: 'M 22 -22 L -2 -28 L -12 -22 L -2 -17 Z', fill: T.canopy, stroke: T.outline, 'stroke-width': 1.2 },
      shipBody
    );
    el('rect', { x: -52, y: -27, width: 9, height: 7, rx: 2, fill: T.metal }, shipBody);
    el('rect', { x: -52, y: -19, width: 9, height: 7, rx: 2, fill: T.metal }, shipBody);
    /*
     * On the fin, not the hull. It used to sit at the hull's midpoint, which is
     * exactly where the canopy is — dark lettering on the dark canopy, so it
     * disappeared. The fin is a clear panel and reads like a livery.
     */
    const hullText = el(
      'text',
      {
        x: -9.5,
        y: -42,
        'text-anchor': 'middle',
        fill: T.monoPlanets ? T.ink : INK,
        'font-size': 5.6,
        'letter-spacing': '0.5',
        'font-weight': 700,
        class: 'leap-label',
      },
      shipBody
    );
    hullText.textContent = 'AI AGENT';
    const shipStruts = el(
      'path',
      {
        d: 'M -16 -12 L -20 2 M 16 -14 L 20 2 M -28 2 L -12 2 M 12 2 L 28 2',
        stroke: T.outline,
        'stroke-width': 2.2,
        'stroke-linecap': 'round',
      },
      shipG
    );
    const liftFlame = el('ellipse', { cx: -58, cy: -23, rx: 26, ry: 7, fill: 'url(#leapGlow)', opacity: 0 }, shipG);

    const rearG = el('g', {}, gShipR);
    const rf1 = el('ellipse', { cx: -13, cy: 9, rx: 11, ry: 6, fill: 'url(#leapGlow)' }, rearG);
    const rf2 = el('ellipse', { cx: 13, cy: 9, rx: 11, ry: 6, fill: 'url(#leapGlow)' }, rearG);
    const rw = { stroke: T.wingEdge, 'stroke-width': 1.4, 'stroke-linejoin': 'round' };
    el('path', { d: 'M -46 -2 L -16 -8 L -16 6 L -44 8 Z', fill: T.wing, ...rw }, rearG);
    el('path', { d: 'M  46 -2 L  16 -8 L  16 6 L  44 8 Z', fill: T.wing, ...rw }, rearG);
    el('path', { d: 'M -46 -2 L -50 -14 L -34 -14 L -30 -5 Z', fill: T.wingLit, ...rw }, rearG);
    el('path', { d: 'M  46 -2 L  50 -14 L  34 -14 L  30 -5 Z', fill: T.wingLit, ...rw }, rearG);
    el(
      'path',
      { d: 'M -18 -10 L 18 -10 L 15 7 L -15 7 Z', fill: T.hullFill, stroke: T.outline, 'stroke-width': 1.6, 'stroke-linejoin': 'round' },
      rearG
    );
    el('path', { d: 'M -13 -8 L 13 -8', stroke: T.accent, 'stroke-width': 2 }, rearG);
    el('rect', { x: -19, y: 0, width: 9, height: 7, rx: 2, fill: T.metal }, rearG);
    el('rect', { x: 10, y: 0, width: 9, height: 7, rx: 2, fill: T.metal }, rearG);
    rearG.appendChild(rf1);
    rearG.appendChild(rf2);

    el(
      'path',
      {
        d: 'M 0 0 H 1200 V 600 H 0 Z M 150 100 Q 600 26 1050 100 L 1120 396 Q 600 482 80 396 Z',
        fill: T.cockFill,
        'fill-rule': 'evenodd',
      },
      gCock
    );
    el(
      'path',
      { d: 'M 150 100 Q 600 26 1050 100 L 1120 396 Q 600 482 80 396 Z', fill: 'none', stroke: T.cockFrame, 'stroke-width': 7 },
      gCock
    );
    el('path', { d: 'M 600 38 L 600 474', stroke: T.cockFrame, 'stroke-width': 6, opacity: 0.85 }, gCock);
    el('path', { d: 'M 150 100 L 80 396 M 1050 100 L 1120 396', stroke: T.cockFrame, 'stroke-width': 5, opacity: 0.7 }, gCock);
    el('rect', { x: 0, y: 396, width: 1200, height: 204, fill: T.cockFill }, gCock);
    el('rect', { x: 330, y: 420, width: 540, height: 104, rx: 2, fill: T.hudFill, stroke: T.hudStroke, 'stroke-width': 2 }, gCock);
    const hudLabel = el(
      'text',
      { x: 600, y: 448, 'text-anchor': 'middle', fill: T.stars ? BIN.b3 : T.ink, 'font-size': 17, 'letter-spacing': '2', class: 'leap-mono' },
      gCock
    );
    hudLabel.textContent = 'APPROACH — AZURE';
    el('rect', { x: 370, y: 464, width: 460, height: 12, rx: 2, fill: T.gaugeTrack }, gCock);
    const fuelBar = el('rect', { x: 370, y: 464, width: 460, height: 12, rx: 2, fill: T.accent }, gCock);
    const fuelTxt = el('text', { x: 370, y: 502, fill: DIM, 'font-size': 13, class: 'leap-mono' }, gCock);
    fuelTxt.textContent = 'FUEL';
    const altTxt = el('text', { x: 830, y: 502, 'text-anchor': 'end', fill: DIM, 'font-size': 13, class: 'leap-mono' }, gCock);
    const flash = el('rect', { x: 0, y: 0, width: 1200, height: 600, fill: T.flash, opacity: 0 }, gFlash);

    const CAMKEYS = [
      { t: 0, pos: [-34, 30, -46] as Vec, tgt: [-6, 6, 74] as Vec },
      { t: 9.8, pos: [4, 28, -40] as Vec, tgt: [-8, 6, 86] as Vec },
      { t: 13.2, pos: [22, 26, -30] as Vec, tgt: [12, 6, 86] as Vec },
      /* settles on the finished hut and holds there */
      { t: 18.6, pos: [26, 21, -12] as Vec, tgt: [6, 6, 74] as Vec },
      /* pulls back and lifts a little to take in the descent */
      { t: 20.4, pos: [30, 24, -10] as Vec, tgt: [16, 14, 80] as Vec },
      { t: 22.6, pos: [38, 20, 4] as Vec, tgt: [26, 8, 84] as Vec },
      { t: 24.6, pos: [52, 17, 22] as Vec, tgt: [22, 7, 96] as Vec },
      { t: 25.6, pos: [60, 22, 14] as Vec, tgt: [20, 12, 92] as Vec },
    ];
    const flightFrac = (t: number) => clamp((t - T_LAUNCH) / (T_TOUCH - T_LAUNCH), 0, 1);

    function camAt(t: number) {
      if (t < T_LAUNCH) {
        let a = CAMKEYS[0],
          b = CAMKEYS[0];
        for (let i = 0; i < CAMKEYS.length - 1; i++)
          if (t <= CAMKEYS[i + 1].t) {
            a = CAMKEYS[i];
            b = CAMKEYS[i + 1];
            break;
          }
        if (t >= CAMKEYS[CAMKEYS.length - 1].t) a = b = CAMKEYS[CAMKEYS.length - 1];
        const s = a === b ? 0 : ease((t - a.t) / (b.t - a.t));
        return { pos: lerp3(a.pos, b.pos, s), tgt: lerp3(a.tgt, b.tgt, s) };
      }
      if (t >= T_TOUCH) {
        /*
         * Settles before the end rather than drifting until the loop restarts,
         * so the last few seconds are a still frame you can actually look at.
         * The hoist is the only thing left moving, which is the point of it.
         */
        const k = ease(clamp((t - T_TOUCH) / (T_SETTLE - T_TOUCH), 0, 1));
        return {
          pos: lerp3([-10, 26, 4], [16, 22, 18], k),
          tgt: lerp3([18, 6, 92], [38, 6, 104], k),
        };
      }
      const s = flightFrac(t);
      const p = flyAt(s),
        ahead = flyAt(Math.min(s + 0.012, 1));
      const fwd = norm(sub(ahead, p));
      if (t < T_COCK) {
        const k = smooth(T_LAUNCH, T_LAUNCH + 2.2, t);
        return { pos: add(sub(p, mul(fwd, lerp(38, 150, k))), [0, lerp(14, 34, k), 0]), tgt: add(p, mul(fwd, 240)) };
      }
      /* Swing the nose onto the destination — looking straight down the path
         tangent leaves Azure off in the corner. */
      const aim = lerp3(add(p, mul(fwd, 260)), PLANETS[4].pos, smooth(T_COCK, T_COCK + 2.4, t) * 0.92);
      return { pos: add(p, mul(fwd, 6)), tgt: aim };
    }

    function view(pos: Vec, target: Vec) {
      const fwd = norm(sub(target, pos));
      const right = norm(cross(fwd, [0, 1, 0]));
      return { pos, fwd, right, up: cross(right, fwd) };
    }
    type V = ReturnType<typeof view>;
    function proj(Vw: V, p: Vec): [number, number, number, number] | null {
      const d = sub(p, Vw.pos);
      const z = dot(d, Vw.fwd);
      if (z <= 1) return null;
      return [CX + (F * dot(d, Vw.right)) / z, CY - (F * dot(d, Vw.up)) / z, z, F / z];
    }

    const terrainVisible = (t: number) => t < T_LAUNCH || t > T_TOUCH;

    /*
     * Type inside the SVG is measured in viewBox units, so on a narrow screen it
     * scales down with everything else — at phone width the labels came out
     * under 3px. These convert a wanted on-screen size into viewBox units, so
     * the drawing shrinks but the writing stays readable.
     */
    const unitsFor = (screenPx: number) => {
      const px = (svg.clientWidth || 1200) / 1200;
      return clamp(screenPx / px, 6.4, 26);
    };

    function render(t: number) {
      const c = camAt(t);
      const labelUnits = unitsFor(14);
      const Vw = view(c.pos, c.tgt);
      const onAzure = t > T_TOUCH;
      const hf = onAzure ? hAzure : hHome;

      gStars.setAttribute('opacity', smooth(T_LAUNCH - 0.1, T_LAUNCH + 1.2, t).toFixed(3));
      if (t > T_LAUNCH - 0.4) {
        for (const s of STARS) {
          const q = proj(Vw, s.p);
          if (!q || q[0] < -60 || q[0] > 1260 || q[1] < -60 || q[1] > 660) {
            hideStar(s);
            continue;
          }
          if (asterisks) {
            const sz = clamp(s.b * q[3] * 95, 1.2, 5);
            s.el.setAttribute(
              'transform',
              `translate(${q[0].toFixed(1)} ${q[1].toFixed(1)}) rotate(${s.rot.toFixed(0)}) scale(${sz.toFixed(2)})`
            );
            /* Ink is far heavier than white on black — keep them delicate. */
            s.el.setAttribute('opacity', clamp(q[3] * 150, 0.1, 0.55).toFixed(2));
          } else {
            s.el.setAttribute('cx', q[0].toFixed(1));
            s.el.setAttribute('cy', q[1].toFixed(1));
            s.el.setAttribute('r', clamp(s.b * q[3] * 80, 0.3, 2.6).toFixed(2));
            s.el.setAttribute('opacity', clamp(q[3] * 260, 0.15, 0.95).toFixed(2));
          }
        }
      } else for (const s of STARS) hideStar(s);

      gSpace.setAttribute(
        'opacity',
        (smooth(T_LAUNCH - 0.3, T_LAUNCH + 1.8, t) * (1 - smooth(T_TOUCH - 0.2, T_TOUCH + 0.5, t))).toFixed(3)
      );
      const vis: { p: P; q: [number, number, number, number]; R: number }[] = [];
      for (const p of ALL) {
        /* While the terrain is on screen we are standing on the home world;
           its disc would blanket the frame. */
        if (p === (HOMEP as P) && t < T_LAUNCH + 0.6) {
          p.g!.setAttribute('display', 'none');
          continue;
        }
        const q = proj(Vw, p.pos);
        if (!q) {
          p.g!.setAttribute('display', 'none');
          continue;
        }
        const R = p.r * q[3];
        if (R < 0.6 || q[0] < -2200 || q[0] > 3400) {
          p.g!.setAttribute('display', 'none');
          continue;
        }
        p.g!.removeAttribute('display');
        vis.push({ p, q, R });
      }
      vis.sort((a, b) => b.q[2] - a.q[2]);
      for (const v of vis) {
        v.p.g!.setAttribute('transform', `translate(${v.q[0].toFixed(1)} ${v.q[1].toFixed(1)})`);
        gSpace.appendChild(v.p.g!);
        v.p.base!.setAttribute('r', v.R.toFixed(1));
        v.p.disc!.setAttribute('r', v.R.toFixed(1));
        v.p.rim!.setAttribute('r', v.R.toFixed(1));
        v.p.rim!.setAttribute('stroke-width', Math.max(v.R * 0.018, 0.7).toFixed(2));
        drawMotif(v.p, v.R);
        const fs = clamp(v.R * 0.26, Math.max(9, labelUnits), 46);
        /* A planet big enough to fill the frame would push its own name off
           screen — keep the label inside the picture. */
        const ly = Math.min(v.R + fs * 1.5, Math.max(250 - v.q[1], -v.q[1] + 250));
        v.p.label!.setAttribute('y', ly.toFixed(1));
        v.p.label!.setAttribute('font-size', fs.toFixed(1));
        v.p.label!.setAttribute('opacity', clamp((v.R - 14) / 60, 0, 1).toFixed(2));
      }

      const tvis = terrainVisible(t);
      setShown(gTerr, tvis);
      setShown(gHaze, tvis);
      if (tvis) {
        const fade = t < T_LAUNCH ? 1 - smooth(T_LAUNCH - 0.9, T_LAUNCH, t) : smooth(T_TOUCH, T_TOUCH + 1, t);
        gTerr.setAttribute('opacity', fade.toFixed(3));
        gHaze.setAttribute('opacity', (fade * 0.9).toFixed(3));
        for (const q of QUADS) {
          const { i, j } = q;
          const corners: Vec[] = [
            [gx(i), 0, gz(j)],
            [gx(i + 1), 0, gz(j)],
            [gx(i + 1), 0, gz(j + 1)],
            [gx(i), 0, gz(j + 1)],
          ];
          let d = '',
            ok = true,
            hs = 0;
          for (let k = 0; k < 4; k++) {
            const h = hf(corners[k][0], corners[k][2]);
            hs += h;
            const s = proj(Vw, [corners[k][0], h, corners[k][2]]);
            if (!s) {
              ok = false;
              break;
            }
            d += (k ? 'L' : 'M') + s[0].toFixed(1) + ' ' + s[1].toFixed(1) + ' ';
          }
          if (!ok) {
            q.el.setAttribute('d', '');
            continue;
          }
          const sh = clamp((hs / 4 + 4) / 24, 0, 1);
          q.el.setAttribute('d', d + 'Z');
          q.el.setAttribute('fill', mix(T.terrLow, onAzure ? BIN.b2 : T.terrHigh, sh * 0.8));
        }
        for (const c2 of CONTOURS) {
          let d = '',
            ok = true;
          for (let i = 0; i <= COLS * 2; i++) {
            const x = lerp(TX0, TX1, i / (COLS * 2)),
              z = gz(c2.j);
            const s = proj(Vw, [x, hf(x, z), z]);
            if (!s) {
              ok = false;
              break;
            }
            d += (i ? 'L' : 'M') + s[0].toFixed(1) + ' ' + s[1].toFixed(1) + ' ';
          }
          c2.el.setAttribute('d', ok ? d : '');
        }
        const sp = proj(Vw, SUN_AT);
        if (sp && !onAzure) {
          sun.setAttribute('cx', sp[0].toFixed(1));
          sun.setAttribute('cy', sp[1].toFixed(1));
          sun.setAttribute('r', (26 * sp[3]).toFixed(1));
          sun.setAttribute('opacity', '0.35');
        } else sun.setAttribute('opacity', '0');
        const far = proj(Vw, [0, hf(0, TZ1), TZ1]);
        if (far) {
          hz.setAttribute('cx', far[0].toFixed(1));
          hz.setAttribute('cy', far[1].toFixed(1));
          hz.setAttribute('rx', (F * 0.42).toFixed(0));
          hz.setAttribute('ry', '52');
        }
      }

      setShown(gProps, tvis);
      if (tvis) {
        gProps.setAttribute('opacity', gTerr.getAttribute('opacity') || '1');
        NODEG.forEach((ng, k) => {
          const n = PROPS[k];
          if (onAzure !== (n.world === 'azure')) {
            ng.g.setAttribute('display', 'none');
            return;
          }
          const s = proj(Vw, [n.x, hf(n.x, n.z), n.z]);
          if (!s) {
            ng.g.setAttribute('display', 'none');
            return;
          }
          ng.g.removeAttribute('display');
          /* Cap the near-field scale, or a landmark the camera drifts up to
             swells until its label alone fills the frame. */
          ng.g.setAttribute(
            'transform',
            `translate(${s[0].toFixed(1)} ${s[1].toFixed(1)}) scale(${clamp(s[3] * S_NODE, 0, 2.4).toFixed(3)})`
          );
          /* the group is scaled by perspective, so undo that for the label */
          const lu = labelUnits / Math.max(clamp(s[3] * S_NODE, 0.001, 2.4), 0.001);
          const lm = (n as { lmul?: number }).lmul ?? 1;
          ng.label.setAttribute('font-size', clamp(lu * lm, 5, 30).toFixed(2));
          ng.label.setAttribute('y', (-(n.h + 6) - lu * lm * 0.8).toFixed(1));
        });

        const showBike = !onAzure && t < T_BOARD;
        setShown(bikeG, showBike);
        if (showBike) {
          const riding = t < T_RIDE;
          const bt = clamp(t / T_RIDE, 0, 1);
          /* he tours the chain, then works it: the ride ends at the forest */
          const route = [
            { x: 20, z: 62 },
            { x: 62, z: 88 },
            { x: 10, z: 130 },
            { x: -50, z: 100 },
          ];
          const seg = clamp(bt * 3, 0, 2.9999);
          const i = Math.floor(seg),
            f = ease(seg - i);
          const a = route[i],
            b = route[i + 1];
          const bx = lerp(a.x, b.x, f),
            bz = lerp(a.z, b.z, f);
          const bx2 = lerp(a.x, b.x, Math.min(f + 0.03, 1)),
            bz2 = lerp(a.z, b.z, Math.min(f + 0.03, 1));
          const by = hf(bx, bz);
          const s = proj(Vw, [bx, by, bz]);
          if (s) {
            const dl = Math.hypot(bx2 - bx, bz2 - bz) || 1;
            const pitch = (-Math.atan2(hf(bx2, bz2) - by, dl) * 180) / Math.PI;
            const bank = (i === 1 ? -9 : i === 2 ? 7 : 3) * (riding ? 1 : 0);
            const bob = riding ? Math.sin(t * 11) * 1.1 : 0;
            const nxt = proj(Vw, [bx2, hf(bx2, bz2), bz2]);
            const dir = nxt && nxt[0] >= s[0] ? 1 : -1;
            const sc = s[3] * S_BIKE;
            bikeG.setAttribute(
              'transform',
              `translate(${s[0].toFixed(1)} ${(s[1] + bob).toFixed(1)}) scale(${(sc * dir).toFixed(3)} ${sc.toFixed(3)})`
            );
            bikeTilt.setAttribute('transform', `rotate(${clamp(pitch, -18, 18).toFixed(1)})`);
            bikeLean.setAttribute('transform', `rotate(${bank.toFixed(1)})`);
            spokes.setAttribute('transform', riding ? `rotate(${(t * 420).toFixed(0)} -7 -6)` : '');
            bikeShadow.setAttribute('opacity', '0.4');
            riderOnBike.setAttribute('opacity', riding ? '1' : '0');
          }
        }

        /*
         * The build. A tree comes down, the logs go to the mill by barrow, the
         * planks come back, and the hut goes up in three stages. Nothing here
         * animates a small gesture — at this size an axe swing would read as
         * jitter — so the beats are all whole objects appearing, moving or
         * falling over.
         */
        if (!onAzure) {
          FOREST.falling!.setAttribute(
            'transform',
            `rotate(${(smooth(T_FELL, T_FELL + 1.2, t) * 82).toFixed(1)} 15 0)`
          );
          FOREST.logs!.setAttribute(
            'opacity',
            (smooth(T_FELL + 1, T_FELL + 1.6, t) * (1 - smooth(T_LOADED - 0.5, T_LOADED, t))).toFixed(2)
          );
          MILL.planks!.setAttribute(
            'opacity',
            (smooth(T_MILLED - 0.7, T_MILLED, t) * (1 - smooth(T_MILLED + 0.4, T_MILLED + 0.9, t))).toFixed(2)
          );
          HUT.walls!.setAttribute('opacity', smooth(T_ATSITE, T_ATSITE + 0.9, t).toFixed(2));
          HUT.roof!.setAttribute('opacity', smooth(T_ATSITE + 0.9, T_ATSITE + 1.7, t).toFixed(2));
          HUT.trim!.setAttribute('opacity', smooth(T_ATSITE + 1.7, T_BUILT, t).toFixed(2));
          /* the hut is only "what I could build" once it is built, and nothing
             casts a shadow before it exists */
          HUT_LABEL.setAttribute('opacity', smooth(T_ATSITE + 1.4, T_BUILT, t).toFixed(2));
          HUT_NODE.shadow.setAttribute(
            'opacity',
            (HUT_NODE.shadowOp * smooth(T_ATSITE, T_ATSITE + 0.9, t)).toFixed(3)
          );
        }

        /* fittings sit on the bench until he collects them */
        if (!onAzure)
          BENCH.parts!.setAttribute(
            'opacity',
            (smooth(T_ATBENCH, T_ATBENCH + 0.6, t) * (1 - smooth(T_FITTED - 0.5, T_FITTED, t))).toFixed(2)
          );

        /*
         * Where the worker is, minute by minute. Forest, mill, bench, site — the
         * bench stop is why the hut has hinges and not only planks.
         */
        const LEGS = [
          { t: T_RIDE, x: -50, z: 100 },
          { t: T_BARROW, x: -56, z: 96 },
          { t: T_LOADED, x: -56, z: 96 },
          { t: T_ATMILL, x: 4, z: 128 },
          { t: T_MILLED, x: 4, z: 128 },
          { t: T_ATBENCH, x: 54, z: 100 },
          { t: T_FITTED, x: 54, z: 100 },
          { t: T_ATSITE, x: 4, z: 64 },
          { t: T_BUILT, x: 12, z: 62 },
        ];
        const working = !onAzure && t >= T_RIDE && t < T_OFF;
        const walking = !onAzure && t >= T_OFF && t < T_BOARD + 0.5;
        /* one place that answers "where is he at time tt", so the same function
           can be asked about a moment slightly ahead to get his heading */
        const wposAt = (tt: number) => {
          if (tt >= T_OFF) {
            const k = ease(clamp((tt - T_OFF) / (T_BOARD - T_OFF), 0, 1));
            return { x: lerp(12, 44, k), z: lerp(62, 70, k), moving: k < 0.96 };
          }
          let a = LEGS[0],
            b = LEGS[LEGS.length - 1];
          for (let i = 0; i < LEGS.length - 1; i++)
            if (tt <= LEGS[i + 1].t) {
              a = LEGS[i];
              b = LEGS[i + 1];
              break;
            }
          const k = a === b ? 1 : ease(clamp((tt - a.t) / (b.t - a.t), 0, 1));
          return {
            x: lerp(a.x, b.x, k),
            z: lerp(a.z, b.z, k),
            moving: Math.hypot(b.x - a.x, b.z - a.z) > 2,
          };
        };
        if (working || walking) {
          const w = wposAt(t);
          const s = proj(Vw, [w.x, hf(w.x, w.z), w.z]);
          if (s) {
            const sc = s[3] * S_WALK;
            /*
             * Which way he is facing, in screen space rather than world space —
             * the camera looks roughly down +z, so world x runs right-to-left on
             * screen and using it directly had him wheeling the barrow backwards
             * on every leg.
             */
            const wn = wposAt(t + 0.25);
            const sn = proj(Vw, [wn.x, hf(wn.x, wn.z), wn.z]);
            const dir = sn && Math.abs(sn[0] - s[0]) > 0.4 ? (sn[0] > s[0] ? 1 : -1) : 1;

            walkerHome.g.setAttribute('opacity', (1 - smooth(T_BOARD - 0.4, T_BOARD + 0.3, t)).toFixed(2));
            walkerHome.g.setAttribute('transform', `translate(${s[0].toFixed(1)} ${s[1].toFixed(1)}) scale(${sc.toFixed(3)})`);
            poseWalker(walkerHome, t * 9, w.moving);
            /* the barrow rides ahead of him, on whichever side he is heading */
            const hauling = working && t > T_BARROW && t < T_ATSITE + 0.4;
            barrowG.setAttribute('opacity', hauling ? '1' : '0');
            if (hauling) {
              barrowG.setAttribute(
                'transform',
                `translate(${(s[0] + sc * 13 * dir).toFixed(1)} ${s[1].toFixed(1)}) scale(${(sc * dir).toFixed(3)} ${sc.toFixed(3)})`
              );
              barrowLogs.setAttribute('opacity', t < T_ATMILL + 0.3 ? '1' : '0');
              barrowPlanks.setAttribute('opacity', t >= T_MILLED && t < T_ATBENCH + 0.3 ? '1' : '0');
              barrowParts.setAttribute('opacity', t >= T_FITTED ? '1' : '0');
            }
          }
        } else {
          walkerHome.g.setAttribute('opacity', '0');
          barrowG.setAttribute('opacity', '0');
        }

        const shipShown = (!onAzure && t >= T_ARRIVE && t < T_LAUNCH) || onAzure;
        shipG.setAttribute(
          'opacity',
          shipShown
            ? (onAzure ? smooth(T_TOUCH, T_TOUCH + 0.8, t) : smooth(T_ARRIVE, T_ARRIVE + 0.4, t)).toFixed(2)
            : '0'
        );
        if (shipShown) {
          const gx0 = onAzure ? 52 : 44,
            gz0 = onAzure ? 82 : 72;
          /*
           * It flies in rather than appearing: drops out of the sky, drifting in
           * from one side, and decelerates into the ground. Squared falloff so
           * it comes down fast and settles slowly, which is what landing looks
           * like.
           */
          const dk = onAzure ? 1 : clamp((t - T_ARRIVE) / (T_DOWN - T_ARRIVE), 0, 1);
          const fall = Math.pow(1 - dk, 2);
          const alt = fall * 76;
          const drift = fall * 30;
          /* Only ~65 units from the camera, so a big lift throws it clean off
             the top of the frame; 18 units already reads as a decisive climb. */
          const lift =
            !onAzure && t > T_LAUNCH - 1.3 ? Math.pow(clamp((t - (T_LAUNCH - 1.3)) / 1.3, 0, 1), 2) * 18 : 0;
          const s = proj(Vw, [gx0 + drift, hf(gx0, gz0) + alt + lift, gz0]);
          if (s) {
            shipG.setAttribute(
              'transform',
              `translate(${s[0].toFixed(1)} ${s[1].toFixed(1)}) scale(${(s[3] * S_SHIP).toFixed(3)})`
            );
            /* gear comes down on short finals */
            shipStruts.setAttribute('opacity', alt > 14 || lift > 2 ? '0' : '1');
            /* the shadow belongs to the ground, so it only exists once it is there */
            shipShadow.setAttribute('opacity', alt > 3 || lift > 2 ? '0' : '0.45');
            liftFlame.setAttribute('opacity', alt > 1.5 || lift > 2 ? '0.9' : '0');
          }
        }

        if (onAzure) {
          /*
           * He steps down and stops. Everything after this happens without him
           * moving again — which is the whole difference the ship made.
           */
          const k = clamp((t - T_TOUCH - 0.5) / 1.6, 0, 1);
          const wx = lerp(50, 40, k),
            wz = lerp(80, 92, k);
          const s = proj(Vw, [wx, hf(wx, wz), wz]);
          if (s) {
            walkerAz.g.setAttribute('opacity', clamp(k * 5, 0, 1).toFixed(2));
            walkerAz.g.setAttribute(
              'transform',
              `translate(${s[0].toFixed(1)} ${s[1].toFixed(1)}) scale(${(s[3] * S_WALK).toFixed(3)})`
            );
            poseWalker(walkerAz, t * 9, k < 0.96);
          }

          /* the crew fans out, one to each tower, all at the same time */
          TOWERS.forEach((tw, i) => {
            const a = AGENTS[i];
            const k2 = clamp((t - T_TEAM - i * 0.18) / 1.7, 0, 1);
            const ax = lerp(46, tw.prop.x + 16, ease(k2)),
              az = lerp(84, tw.prop.z - 10, ease(k2));
            const sa = proj(Vw, [ax, hf(ax, az), az]);
            if (!sa) {
              a.g.setAttribute('opacity', '0');
              return;
            }
            a.g.setAttribute('opacity', clamp((t - T_TEAM) * 3, 0, 1).toFixed(2));
            a.g.setAttribute(
              'transform',
              `translate(${sa[0].toFixed(1)} ${sa[1].toFixed(1)}) scale(${(sa[3] * S_WALK * 0.9).toFixed(3)})`
            );
            poseWalker(a, t * 9 + i, k2 < 0.98);

            /* and the tower each one went to comes up behind them */
            const rise = smooth(T_RISE + i * 0.5, T_RISE + i * 0.5 + 2.4, t);
            tw.node.h.body!.setAttribute('transform', `scale(1 ${Math.max(rise, 0.001).toFixed(3)})`);
            tw.node.label.setAttribute('opacity', smooth(T_RISE + i * 0.5 + 1.6, T_RISE + i * 0.5 + 2.4, t).toFixed(2));
            tw.node.shadow.setAttribute('opacity', (tw.node.shadowOp * rise).toFixed(3));
          });

          /* the answer to the hut's label, once there is something to answer with */
          TITLE_NODE.label.setAttribute('opacity', smooth(T_RISE + 4, T_RISE + 4.9, t).toFixed(2));
          /* the perimeter is drawn before anything goes up inside it */
          SITE.fence!.setAttribute('opacity', (smooth(T_FENCE, T_FENCE + 1.2, t) * 0.75).toFixed(2));
          /* and the hoist just keeps going */
          SITE.hoist!.setAttribute('opacity', smooth(T_RISE, T_RISE + 1, t).toFixed(2));
          const car = SITE.hoist!.querySelector('.leap-car');
          if (car) car.setAttribute('y', (-12 - 58 * (0.5 - 0.5 * Math.cos(t * 1.9))).toFixed(1));
        } else {
          walkerAz.g.setAttribute('opacity', '0');
          for (const a of AGENTS) a.g.setAttribute('opacity', '0');
        }
      }

      const chase = t >= T_LAUNCH && t < T_COCK;
      gShipR.setAttribute(
        'opacity',
        chase ? (smooth(T_LAUNCH, T_LAUNCH + 0.7, t) * (1 - smooth(T_COCK - 0.9, T_COCK, t))).toFixed(2) : '0'
      );
      if (chase) {
        const s = flightFrac(t);
        const p = flyAt(s),
          q = proj(Vw, p);
        if (q) {
          const q2 = proj(Vw, flyAt(Math.min(s + 0.02, 1)));
          const yaw = q2 ? clamp((q2[0] - q[0]) * 0.05, -14, 14) : 0;
          gShipR.setAttribute(
            'transform',
            `translate(${q[0].toFixed(1)} ${q[1].toFixed(1)}) rotate(${yaw.toFixed(1)}) scale(${clamp(q[3] * 150, 0.4, 3.2).toFixed(3)})`
          );
          const fl = (0.7 + 0.3 * Math.sin(t * 22)).toFixed(2);
          rf1.setAttribute('opacity', fl);
          rf2.setAttribute('opacity', fl);
        }
      }

      const inCock = t >= T_COCK - 0.4;
      gCock.setAttribute(
        'opacity',
        inCock ? (smooth(T_COCK - 0.4, T_COCK + 0.6, t) * (1 - smooth(T_TOUCH - 0.3, T_TOUCH + 0.4, t))).toFixed(2) : '0'
      );
      if (inCock) {
        const az = proj(Vw, PLANETS[4].pos);
        const alt = az ? Math.max(0, az[2] - PLANETS[4].r) : 0;
        altTxt.textContent = 'ALT ' + Math.round(alt).toString().padStart(4, '0');
        const fuel = 1 - flightFrac(t) * 0.82;
        fuelBar.setAttribute('width', (460 * fuel).toFixed(0));
        fuelBar.setAttribute('fill', fuel < 0.3 ? '#a8391c' : T.accent);
      }
      flash.setAttribute(
        'opacity',
        t > T_TOUCH - 0.35 && t < T_TOUCH + 0.5 ? ((1 - Math.abs(t - T_TOUCH) / 0.45) * 0.85).toFixed(2) : '0'
      );

      let ch = CHAPTERS[0];
      for (const c2 of CHAPTERS) if (t >= c2.t) ch = c2;
      titleEl.textContent = ch.title;
      textEl.textContent = ch.text;
    }

    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let t = 0,
      playing = !reduce.matches,
      last = performance.now(),
      raf = 0;

    function setLabel() {
      toggle.textContent = playing ? 'Pause' : 'Play';
      toggle.setAttribute('aria-label', playing ? 'Pause animation' : 'Play animation');
    }
    function tick() {
      const now = performance.now();
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      if (playing) {
        t += dt;
        if (t >= DUR) t = 0;
        render(t);
      }
      raf = requestAnimationFrame(tick);
    }
    toggle.addEventListener('click', () => {
      playing = !playing;
      last = performance.now();
      setLabel();
      if (playing && !raf) tick();
    });

    /* Pause when off screen: no point animating what nobody is looking at. */
    let onScreen = true;
    new IntersectionObserver(
      (entries) => {
        onScreen = entries[0].isIntersecting;
        if (!onScreen && raf) {
          cancelAnimationFrame(raf);
          raf = 0;
        } else if (onScreen && playing && !raf) {
          last = performance.now();
          tick();
        }
      },
      { threshold: 0.05 }
    ).observe(root);

    setLabel();
    if (playing) {
      render(0);
      tick();
    } else {
      render(STILL_T);
    }
  }

  document.querySelectorAll<HTMLElement>('[data-agent-leap]').forEach(build);
</script>

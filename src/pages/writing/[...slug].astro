---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Mark from '../../components/Mark.astro';
import { TRACKS } from '../../tracks';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

// Send readers back to the track this post belongs to, not a generic index.
const track = TRACKS.find((t) => t.id === post.data.track);

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <article class="post">
    <header class="post__head">
      <h1>{post.data.title}</h1>
      <div class="post__meta">
        <time datetime={post.data.date.toISOString()}>
          {dateFormat.format(post.data.date)}
        </time>
        {
          post.data.tags.length > 0 && (
            <ul class="post__tags" role="list">
              <li class="visually-hidden">Tags:</li>
              {post.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
      </div>
      {
        post.data.repo && (
          <p class="post__repo">
            <a href={post.data.repo}>Source repository</a>
          </p>
        )
      }
    </header>

    <div class="post__body">
      <Content />
    </div>

    {
      post.data.paper && (
        <aside class="citation" aria-labelledby="citation-label">
          <Mark name={post.data.paper.mark} />
          <div>
            <p class="citation__label" id="citation-label">
              Publication
            </p>
            <p class="citation__title">{post.data.paper.title}</p>
            {post.data.paper.authors && (
              <p class="citation__authors">{post.data.paper.authors}</p>
            )}
            <p class="citation__venue">
              {[post.data.paper.venue, post.data.paper.year].filter(Boolean).join(' · ')}
            </p>
            {post.data.paper.url && (
              <p class="citation__link">
                <a href={post.data.paper.url}>Read the paper</a>
              </p>
            )}
            {post.data.paper.talk && (
              <p class="citation__link">
                <a href={post.data.paper.talk}>Watch the talk</a>
              </p>
            )}
          </div>
        </aside>
      )
    }
  </article>

  {
    track && (
      <p class="post__back">
        <a href={`/${track.id}/`}>Back to {track.title}</a>
      </p>
    )
  }
</BaseLayout>

<style>
  .post {
    max-width: var(--measure);
  }

  .post__head {
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--space-6);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-2);
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  .post__repo {
    margin-top: var(--space-3);
    font-size: var(--step--1);
  }

  /* Vertical rhythm for prose comes from the space scale, not from margins
     invented per element. */
  .post__body :global(> * + *) {
    margin-top: var(--space-5);
  }

  .post__body :global(h2) {
    margin-top: var(--space-7);
  }

  .post__body :global(h3) {
    margin-top: var(--space-6);
  }

  .post__body :global(ul),
  .post__body :global(ol) {
    padding-left: var(--space-5);
  }

  .post__body :global(li + li) {
    margin-top: var(--space-2);
  }

  .post__body :global(blockquote) {
    border-left: 2px solid var(--line-strong);
    padding-left: var(--space-4);
    color: var(--text-1);
  }

  /*
   * The reference the article is written around. Set off from the prose by a
   * rule and the same left-hand mark the listings use, so it reads as a record
   * rather than a closing paragraph — mono for the label and the venue, sans
   * for the title, which is the one line meant to be read as text.
   */
  .citation {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  .citation__label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-2);
  }

  .citation__title {
    margin-top: var(--space-2);
    font-size: var(--step-0);
    font-weight: 600;
    text-wrap: pretty;
  }

  .citation__authors {
    margin-top: var(--space-1);
    font-size: var(--step--1);
    color: var(--text-1);
  }

  .citation__venue {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-2);
  }

  .citation__link {
    margin-top: var(--space-3);
    font-size: var(--step--1);
  }

  /* Consecutive links group together rather than reading as separate blocks. */
  .citation__link + .citation__link {
    margin-top: var(--space-2);
  }

  /* Matches the entry mark's narrow-screen column so the two stay in step. */
  @media (max-width: 40rem) {
    .citation {
      grid-template-columns: 2.5rem 1fr;
      gap: var(--space-3);
    }
  }

  .post__back {
    margin-top: var(--space-8);
    font-size: var(--step--1);
  }
</style>

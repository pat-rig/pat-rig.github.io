---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Mark from '../../components/Mark.astro';
import { TRACKS } from '../../tracks';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

/*
 * Only h2 and h3 carry an article's structure — h4 and below are detail, and
 * listing them turns the aside into a second article. Astro has already given
 * every heading an id, so an entry needs nothing but a link.
 *
 * Below three headings there is nothing to navigate: the shape of the page is
 * visible from one scroll, and a two-item list is furniture.
 */
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = toc.length >= 3;

// Send readers back to the track this post belongs to, not a generic index.
const track = TRACKS.find((t) => t.id === post.data.track);

/*
 * Month and year, no day. A post is dated to when its work happened, and for
 * older work the day is false precision — the CS-VAE post's day came from a
 * PDF's compile timestamp. The `datetime` attribute still carries the full
 * date for machines.
 */
const dateFormat = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'long',
  timeZone: 'UTC',
});
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <div class:list={['layout', showToc && 'layout--toc']}>
    <article class="post">
      <header class="post__head">
        <h1>{post.data.title}</h1>
        <div class="post__meta">
          <time datetime={post.data.date.toISOString()}>
            {dateFormat.format(post.data.date)}
          </time>
          {
            post.data.tags.length > 0 && (
              <ul class="post__tags" role="list">
                <li class="visually-hidden">Tags:</li>
                {post.data.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            )
          }
        </div>
        {
          post.data.repo && (
            <p class="post__repo">
              <a href={post.data.repo} target="_blank" rel="noopener">
                Source repository
                <span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            </p>
          )
        }
      </header>

      <div class="post__body">
        <Content />
      </div>

      {
        post.data.paper && (
          <aside class="citation" aria-labelledby="citation-label">
            <Mark name={post.data.paper.mark} />
            <div>
              <p class="citation__label" id="citation-label">
                {post.data.paper.label ?? 'Publication'}
              </p>
              <p class="citation__title">{post.data.paper.title}</p>
              {post.data.paper.authors && (
                <p class="citation__authors">{post.data.paper.authors}</p>
              )}
              <p class="citation__venue">
                {[post.data.paper.venue, post.data.paper.year].filter(Boolean).join(' · ')}
              </p>
              {/*
                The reference apparatus opens in a new tab: a paper, a talk or
                a codebase is something a reader consults alongside the article
                rather than instead of it.

                `rel="noopener"` is belt-and-braces — browsers imply it for
                `target="_blank"` now — and the visually-hidden note is how a
                screen reader learns the tab will change, since the design
                system forbids appended arrows (§2) and the affordance
                therefore cannot be a visual one.
              */}
              {post.data.paper.url && (
                <p class="citation__link">
                  <a href={post.data.paper.url} target="_blank" rel="noopener">
                    Read the paper
                    <span class="visually-hidden"> (opens in a new tab)</span>
                  </a>
                </p>
              )}
              {post.data.paper.talk && (
                <p class="citation__link">
                  <a href={post.data.paper.talk} target="_blank" rel="noopener">
                    Watch the talk
                    <span class="visually-hidden"> (opens in a new tab)</span>
                  </a>
                </p>
              )}
            </div>
          </aside>
        )
      }
    </article>

    {
      track && (
        <p class="post__back">
          <a href={`/${track.id}/`}>Back to {track.title}</a>
        </p>
      )
    }

    {
      showToc && (
        <nav class="toc" aria-labelledby="toc-label">
          <p class="toc__label" id="toc-label">
            Contents
          </p>
          <ul class="toc__list" role="list">
            {toc.map((heading) => (
              <li class:list={['toc__item', heading.depth === 3 && 'toc__item--sub']}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</BaseLayout>

<style>
  .post {
    max-width: var(--measure);
  }

  /*
   * Contents rail. Desktop only, by design: it lives in space that only exists
   * once the viewport is wider than the reading measure, and on a phone a list
   * of four links above the article is worse than no list at all. Below the
   * breakpoint the whole nav is simply not painted, and the page is byte-for-
   * byte what it was before.
   *
   * The breakpoint is set by arithmetic, not taste: the shell leaves about
   * 62rem of content at a 66rem viewport, and the measure plus the gap plus
   * the rail asks for about 55rem.
   */
  @media (min-width: 66rem) {
    .layout--toc {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 14rem;
      column-gap: var(--space-8);
      /*
       * Not `stretch`: a rail stretched to the article's height has nowhere to
       * travel, and sticky would do nothing. Sized to its content, it sticks
       * against the grid container instead — which is as tall as the article.
       */
      align-items: start;
    }

    /* The article and its back-link stay one column; the rail sits beside them. */
    .layout--toc .post,
    .layout--toc .post__back {
      grid-column: 1;
    }

    .layout--toc .toc {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: var(--space-6);
    }
  }

  .toc {
    display: none;
  }

  @media (min-width: 66rem) {
    .toc {
      display: block;
      /* Aligns the rail's first line with the article title's cap height. */
      padding-top: var(--space-2);
      border-left: 1px solid var(--line);
      padding-left: var(--space-5);
      font-size: var(--step--1);
    }
  }

  .toc__label {
    font-family: var(--font-mono);
    color: var(--text-2);
  }

  .toc__list {
    list-style: none;
    padding: 0;
    margin-top: var(--space-4);
  }

  .toc__item + .toc__item {
    margin-top: var(--space-3);
  }

  .toc__item--sub {
    padding-left: var(--space-4);
  }

  .toc__item a {
    color: var(--text-1);
    text-wrap: pretty;
  }

  .toc__item a:hover {
    color: var(--text-0);
  }

  .post__head {
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--space-6);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-2);
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  .post__repo {
    margin-top: var(--space-3);
    font-size: var(--step--1);
  }

  /* Vertical rhythm for prose comes from the space scale, not from margins
     invented per element. */
  .post__body :global(> * + *) {
    margin-top: var(--space-5);
  }

  .post__body :global(h2) {
    margin-top: var(--space-7);
  }

  .post__body :global(h3) {
    margin-top: var(--space-6);
  }

  /* Jumping from the rail should not land a heading flush against the top. */
  .post__body :global(h2),
  .post__body :global(h3) {
    scroll-margin-top: var(--space-6);
  }

  .post__body :global(ul),
  .post__body :global(ol) {
    padding-left: var(--space-5);
  }

  .post__body :global(li + li) {
    margin-top: var(--space-2);
  }

  .post__body :global(blockquote) {
    border-left: 2px solid var(--line-strong);
    padding-left: var(--space-4);
    color: var(--text-1);
  }

  /*
   * A collapsible aside — the maths of a section, folded away by default so the
   * argument reads straight through for anyone who does not want it.
   *
   * `<details>` and nothing else: the disclosure behaviour is native, so this
   * works with the site's `script-src 'self'` and zero JavaScript, and
   * find-in-page still opens the fold to reach what is inside it.
   */
  .post__body :global(details.formal) {
    margin-block: var(--space-6);
  }

  .post__body :global(details.formal > summary) {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    width: fit-content;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-1);
    /* Both spellings are needed: WebKit still ships the pseudo-element. */
    list-style: none;
  }

  .post__body :global(details.formal > summary::-webkit-details-marker) {
    display: none;
  }

  /*
   * The site has no icon set and no colour accents, so the affordance is a
   * mono +/− — the same character pair in the same face as the label, which is
   * also why it does not shift the text when it flips.
   */
  .post__body :global(details.formal > summary::before) {
    content: '+';
    color: var(--text-2);
  }

  .post__body :global(details.formal[open] > summary::before) {
    content: '\2212';
  }

  .post__body :global(details.formal > summary:hover) {
    color: var(--text-0);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: var(--line-strong);
  }

  /*
   * The prose rhythm above is set on `.post__body`'s direct children only, and
   * nothing inside the fold or inside a definition is one. Restate it here —
   * tighter within a definition, where the statement and its equation are one
   * thought rather than two.
   */
  .post__body :global(details.formal > * + *) {
    margin-top: var(--space-5);
  }

  .post__body :global(details.formal > summary + *) {
    margin-top: var(--space-6);
  }

  .post__body :global(.def > * + *) {
    margin-top: var(--space-4);
  }

  /*
   * Theorem environment. A definition is set off from the prose the way this
   * site sets off anything else: a hairline above and below and room to
   * breathe. No box, no tint, no left bar — a left bar is the blockquote's
   * job, and a definition is not a quotation.
   *
   * The run-in "**Definition n (Name).**" label is written in the markdown
   * rather than generated, so the numbering is visible where the prose is
   * edited and cannot silently renumber itself.
   */
  .post__body :global(.def) {
    margin-block: var(--space-6);
    padding-block: var(--space-5);
    border-block: 1px solid var(--line);
  }

  /* The rules already separate it; the paragraph gap would double the top. */
  .post__body :global(.def > *:first-child) {
    margin-top: 0;
  }

  /*
   * The figure sits directly on the page ground — no frame, no fill, no
   * surface step. The marks beside listing entries get a bordered plate
   * because they are labels; this is a reading of data, and a box around it
   * would read as a widget pasted into the article.
   */
  .post__body :global(.def__figure) {
    margin-top: var(--space-6);
    margin-inline: auto;
    /* Wider than this and it stops reading as a diagram beside an argument. */
    max-width: 20rem;
  }

  .post__body :global(.def__figure figcaption) {
    margin-top: var(--space-3);
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .post__body :global(.reliability) {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Structure the eye should read past: the frame of reference, not the data. */
  .post__body :global(.rd-axis line) {
    stroke: var(--line-strong);
    stroke-width: 1;
  }

  .post__body :global(.rd-diagonal) {
    stroke: var(--line-strong);
    stroke-width: 1;
    stroke-dasharray: 4 4;
  }

  /* The measured curve is the one thing drawn at full text weight. */
  .post__body :global(.rd-curve) {
    fill: none;
    stroke: var(--text-0);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Filled with the page ground so each bin punches through the line. */
  .post__body :global(.rd-point circle) {
    fill: var(--surface-0);
    stroke: var(--text-0);
    stroke-width: 2;
  }

  .post__body :global(.rd-gap line) {
    stroke: var(--text-1);
    stroke-width: 1;
  }

  /*
   * Sizes are in viewBox units, not screen pixels. The 300-unit square is drawn
   * at roughly 320px, so these land near their face value — but they scale with
   * the figure, so changing its max-width changes the label size too.
   */
  .post__body :global(.reliability text) {
    font-family: var(--font-mono);
    fill: var(--text-2);
    font-size: 11px;
  }

  .post__body :global(.rd-gap-label) {
    fill: var(--text-1);
  }

  .post__body :global(.rd-region) {
    font-size: 10px;
  }

  .post__body :global(.rd-tick) {
    font-size: 10px;
  }

  .post__body :global(.rd-tick text) {
    text-anchor: middle;
  }

  .post__body :global(.rd-tick--y) {
    text-anchor: end;
  }

  .post__body :global(.rd-axis-label) {
    fill: var(--text-1);
    text-anchor: middle;
  }

  /*
   * Maths is rendered to MathML at build time (see astro.config.mjs). Display
   * equations arrive as an inline `<span class="katex">` around a
   * `<math display="block">`, so the span has to be told it is a block before
   * the centring below can apply. A long equation scrolls inside its own line
   * rather than pushing the page sideways.
   */
  .post__body :global(.katex:has(math[display='block'])) {
    display: block;
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: var(--space-2);
  }

  .post__body :global(math[display='block']) {
    margin-inline: auto;
  }

  /*
   * The reference the article is written around. Set off from the prose by a
   * rule and the same left-hand mark the listings use, so it reads as a record
   * rather than a closing paragraph — mono for the label and the venue, sans
   * for the title, which is the one line meant to be read as text.
   */
  .citation {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  .citation__label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-2);
  }

  .citation__title {
    margin-top: var(--space-2);
    font-size: var(--step-0);
    font-weight: 600;
    text-wrap: pretty;
  }

  .citation__authors {
    margin-top: var(--space-1);
    font-size: var(--step--1);
    color: var(--text-1);
  }

  .citation__venue {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-2);
  }

  .citation__link {
    margin-top: var(--space-3);
    font-size: var(--step--1);
  }

  /* Consecutive links group together rather than reading as separate blocks. */
  .citation__link + .citation__link {
    margin-top: var(--space-2);
  }

  /* Matches the entry mark's narrow-screen column so the two stay in step. */
  @media (max-width: 40rem) {
    .citation {
      grid-template-columns: 2.5rem 1fr;
      gap: var(--space-3);
    }
  }

  .post__back {
    margin-top: var(--space-8);
    font-size: var(--step--1);
  }
</style>

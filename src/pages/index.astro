---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Entry from '../components/Entry.astro';
import Disclaimer from '../components/Disclaimer.astro';
import portrait from '../assets/portrait.jpg';
import { SITE_NAME } from '../site';
import { TRACKS } from '../tracks';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

/** Up to three entries per track on the landing page; the rest live on /writing/. */
const byTrack = TRACKS.map((track) => ({
  track,
  posts: posts.filter((post) => post.data.track === track.id),
}));
---

<BaseLayout
  title={SITE_NAME}
  description="Machine learning, data science and AI in business, through the lens of projects built over the years."
>
  <section class="hero">
    <Image
      class="hero__portrait"
      src={portrait}
      alt={SITE_NAME}
      widths={[240, 480, 720]}
      sizes="(max-width: 30rem) 11rem, (max-width: 55rem) 10rem, 15rem"
      loading="eager"
    />
    <div>
      <p class="hero__kicker">Machine Learning, Data Science and Business AI</p>
      <h1>
        <span class="hero__greeting">Hello world,</span>
        what a time to be alive!
      </h1>
      <p class="hero__lede">
        An insight into my perspective on machine learning, data science and AI in business
        through the lens of projects that I have built over the years.
      </p>
      <p class="hero__note">
        <span class="hero__note-line">
          Written in a personal capacity — these are my own views, not my employer’s.
        </span>
        <a href="#disclaimer">Full note</a>
      </p>
      <div class="hero__meta">
        <span><a href="https://github.com/pat-rig">GitHub</a></span>
      </div>
    </div>
  </section>

  <div class="tracks">
    {
      byTrack.map(({ track, posts: trackPosts }) => (
        <section class="track" id={track.id}>
          <div class="track__head">
            <span class="track__kicker">{track.kicker}</span>
            <h2 class="track__title">{track.title}</h2>
            <p class="track__desc">{track.description}</p>
          </div>

          {trackPosts.length > 0 ? (
            <ul class="entries" role="list">
              {trackPosts.slice(0, 3).map((post) => (
                <Entry post={post} />
              ))}
            </ul>
          ) : (
            <p class="track__empty">Nothing published here yet.</p>
          )}

          <p class="track__more">
            <a href={`/writing/#${track.id}`}>{track.moreLabel}</a>
          </p>
        </section>
      ))
    }
  </div>

  <Disclaimer />
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 15rem 1fr;
    gap: var(--space-7);
    align-items: start;
    padding-block: var(--space-6) var(--space-8);
  }

  /* Rectangular with a hairline — no rounded avatar, no shadow (docs/design.md §2, §5) */
  .hero__portrait {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--line);
  }

  .hero__kicker {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-2);
    margin-bottom: var(--space-3);
  }

  .hero h1 {
    font-size: var(--step-4);
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }

  .hero__greeting {
    display: block;
  }

  .hero__lede {
    margin-top: var(--space-5);
    font-size: var(--step-1);
    color: var(--text-1);
    max-width: var(--measure);
  }

  .hero__note {
    margin-top: var(--space-4);
    font-size: var(--step--1);
    color: var(--text-2);
    max-width: var(--measure);
  }

  .hero__note-line {
    display: block;
  }

  .hero__meta {
    margin-top: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-2);
  }

  .tracks {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 2px solid var(--text-0);
  }

  .track {
    padding-block: var(--space-6) var(--space-8);
  }

  .track:first-child {
    padding-right: var(--space-7);
    border-right: 1px solid var(--line);
  }

  .track:last-child {
    padding-left: var(--space-7);
  }

  .track__head {
    margin-bottom: var(--space-6);
  }

  .track__kicker {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-2);
    margin-bottom: var(--space-2);
  }

  .track__title {
    font-size: var(--step-2);
    letter-spacing: -0.01em;
  }

  .track__desc {
    margin-top: var(--space-3);
    color: var(--text-1);
  }

  .entries {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .track__empty {
    color: var(--text-1);
    border-top: 1px solid var(--line);
    padding-top: var(--space-5);
  }

  .track__more {
    margin-top: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  /* The two tracks stack below 55rem; the divider becomes horizontal. */
  @media (max-width: 55rem) {
    .hero {
      grid-template-columns: 10rem 1fr;
      gap: var(--space-5);
    }

    .tracks {
      grid-template-columns: 1fr;
    }

    .track:first-child {
      padding-right: 0;
      border-right: 0;
      border-bottom: 1px solid var(--line-strong);
    }

    .track:last-child {
      padding-left: 0;
    }
  }

  @media (max-width: 30rem) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero__portrait {
      max-width: 11rem;
    }
  }
</style>

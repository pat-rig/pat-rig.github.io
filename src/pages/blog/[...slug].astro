---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <article class="post">
    <header class="post__head">
      <h1>{post.data.title}</h1>
      <div class="post__meta">
        <time datetime={post.data.date.toISOString()}>
          {dateFormat.format(post.data.date)}
        </time>
        {
          post.data.tags.length > 0 && (
            <ul class="post__tags" role="list">
              <li class="visually-hidden">Tags:</li>
              {post.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
      </div>
      {
        post.data.repo && (
          <p class="post__repo">
            <a href={post.data.repo}>Source repository</a>
          </p>
        )
      }
    </header>

    <div class="post__body">
      <Content />
    </div>
  </article>

  <p class="post__back"><a href="/">Back to writing</a></p>
</BaseLayout>

<style>
  .post {
    max-width: var(--measure);
  }

  .post__head {
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--space-6);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-2);
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  .post__repo {
    margin-top: var(--space-3);
    font-size: var(--step--1);
  }

  /* Vertical rhythm for prose comes from the space scale, not from margins
     invented per element. */
  .post__body :global(> * + *) {
    margin-top: var(--space-5);
  }

  .post__body :global(h2) {
    margin-top: var(--space-7);
  }

  .post__body :global(h3) {
    margin-top: var(--space-6);
  }

  .post__body :global(ul),
  .post__body :global(ol) {
    padding-left: var(--space-5);
  }

  .post__body :global(li + li) {
    margin-top: var(--space-2);
  }

  .post__body :global(blockquote) {
    border-left: 2px solid var(--line-strong);
    padding-left: var(--space-4);
    color: var(--text-1);
  }

  .post__back {
    margin-top: var(--space-8);
    font-size: var(--step--1);
  }
</style>
